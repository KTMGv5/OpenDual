<Window x:Class="OpenDualHub.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDual Initial Setup"
        Width="760" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="SetupBg" Color="#090D16"/>
        <SolidColorBrush x:Key="CardBg" Color="#101726"/>
        <SolidColorBrush x:Key="CardHoverBg" Color="#152036"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1E2B45"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2979FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="TextMain" Color="#F0F5FF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A9BB8"/>

        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Background" Value="#182236"/>
            <Setter Property="Foreground" Value="#F0F5FF"/>
            <Setter Property="BorderBrush" Value="#283959"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00F5D4"/>
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Pill" Background="#162033" BorderBrush="#283856" BorderThickness="1" CornerRadius="14">
                            <TextBlock x:Name="Lbl" Text="OFF" Foreground="#8A9BB8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2200F5D4"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#00F5D4"/>
                                <Setter TargetName="Lbl" Property="Text" Value="ON"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="#00F5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SetupBg}" BorderBrush="#243554" BorderThickness="1.5" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <!-- HEADER BAR -->
            <Border Grid.Row="0" Background="#0C121F" CornerRadius="15,15,0,0" BorderBrush="#1A253B" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#1800F5D4" BorderBrush="#00F5D4" BorderThickness="1.2" Margin="0,0,14,0">
                            <TextBlock Text="🎮" FontSize="18" Foreground="#00F5D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OPENDUAL WELCOME &amp; INITIAL SETUP" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <Border Background="#1A00F5D4" BorderBrush="#00F5D4" BorderThickness="1" CornerRadius="5" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStepBadge" Text="STEP 1 OF 3" FontSize="9.5" FontWeight="Bold" Foreground="#00F5D4"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtHeaderSubtitle" Text="Configure hardware polling, performance mode, and starting controller behavior" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Step Progress Dots -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStep1" Width="10" Height="10" Fill="#00F5D4" Margin="0,0,8,0"/>
                        <Ellipse x:Name="DotStep2" Width="10" Height="10" Fill="#253552" Margin="0,0,8,0"/>
                        <Ellipse x:Name="DotStep3" Width="10" Height="10" Fill="#253552" Margin="0,0,16,0"/>
                        <Button Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#8A9BB8" BorderThickness="0" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnSkip_Click" ToolTip="Skip &amp; Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY CONTENT -->
            <Grid Grid.Row="1" Margin="24,18,24,12">

                <!-- ==================== STEP 1: HARDWARE & PERFORMANCE ==================== -->
                <StackPanel x:Name="PanelStep1" Visibility="Visible">
                    <TextBlock Text="1. Hardware Connection &amp; Graphics Performance" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4"/>
                    <TextBlock Text="Verify your DualSense kernel link and select the best rendering mode for your PC hardware." FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                    <!-- Live Hardware Status Banner -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="#00F5D4" BorderThickness="1.2" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DotDriverStatus" Width="9" Height="9" Fill="#00E676" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtDriverHeadline" Text="1000Hz Direct HID Kernel Engine Active" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtDriverSub" Text="Overlapped Win32 I/O pipe connected • Sub-millisecond input &amp; output reports ready" FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="17,3,0,0"/>
                            </StackPanel>
                            <Border Background="#142238" BorderBrush="#263B5E" BorderThickness="1" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPollingPill" Text="1000 Hz • 1.0 ms" FontSize="10.5" FontWeight="Bold" Foreground="#00E676"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- UI Graphics Performance Mode -->
                    <TextBlock Text="CHOOSE INTERFACE RENDERING MODE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CardPerfFull" Grid.Column="0" Background="#132238" BorderBrush="#00F5D4" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Cursor="Hand" MouseLeftButtonDown="CardPerfFull_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="✨ Dynamic 60 FPS Wave Art" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock x:Name="BadgePerfFull" Text="SELECTED" FontSize="9" FontWeight="Bold" Foreground="#00F5D4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Animated XMB ribbon background and full telemetry visualizers. Ideal for modern gaming PCs." FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardPerfLight" Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Cursor="Hand" MouseLeftButtonDown="CardPerfLight_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="⚡ Lightweight Low-Spec Mode" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock x:Name="BadgePerfLight" Text="LOW GPU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Disables background wave rendering loops for zero GPU overhead on laptops &amp; low-end PCs." FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Battery & Startup Toggles -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Battery Longevity Sentinel &amp; Thermal Guard" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Protects battery health at 80% charge over USB and prevents adaptive trigger coil overheating" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleSetupBatteryGuard" Style="{StaticResource SetupToggle}" IsChecked="True" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start Minimized in System Tray on Close" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Keeps your custom profile, haptics, and trigger tuning active while gaming in the background" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleSetupTray" Style="{StaticResource SetupToggle}" IsChecked="True" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== STEP 2: PLAYSTYLE & PRO TUNING ==================== -->
                <StackPanel x:Name="PanelStep2" Visibility="Collapsed">
                    <TextBlock Text="2. Select Your Starting Playstyle Profile" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4"/>
                    <TextBlock Text="Pick the preset that best matches how you play. You can switch or customize profiles anytime." FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Option 1: Standard Balanced -->
                        <Border x:Name="CardPlayBalanced" Grid.Row="0" Grid.Column="0" Background="#132238" BorderBrush="#00F5D4" BorderThickness="1.5" CornerRadius="10" Padding="14" Cursor="Hand" MouseLeftButtonDown="CardPlaystyle_Click" Tag="Balanced">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🎮 Standard Balanced" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <Border Background="#2200F5D4" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="DEFAULT" FontSize="9" FontWeight="Bold" Foreground="#00F5D4"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Crisp tactile trigger snap on L2/R2, balanced thumbstick deadzones, Audio-to-Haptics bass active, and signature cyan lightbar." FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Option 2: Pro Response Esports -->
                        <Border x:Name="CardPlayEsports" Grid.Row="0" Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14" Cursor="Hand" MouseLeftButtonDown="CardPlaystyle_Click" Tag="Esports">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🏆 Esports Pro Response" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <Border Background="#2200E676" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="1000Hz PRO" FontSize="9" FontWeight="Bold" Foreground="#00E676"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Activates Rapid Trigger (&lt;1.2mm instant reset), Dual-Stage Trigger, Outer-Ring Auto-Sprint (96%), and Virtual Hall-Effect Stabilizer." FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Option 3: FPS Motion Aim -->
                        <Border x:Name="CardPlayFps" Grid.Row="2" Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14" Cursor="Hand" MouseLeftButtonDown="CardPlaystyle_Click" Tag="FPS">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🎯 FPS Gyro &amp; Recoil Assist" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <Border Background="#222979FF" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="MOTION AIM" FontSize="9" FontWeight="Bold" Foreground="#448AFF"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Enables 6-Axis Gyro Aiming, Touchpad Gyro Pause (wrist recentering), Adaptive Vertical Recoil Assist, and Spatial Audio Footstep Radar." FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Option 4: Sim Racing -->
                        <Border x:Name="CardPlayRacing" Grid.Row="2" Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14" Cursor="Hand" MouseLeftButtonDown="CardPlaystyle_Click" Tag="Racing">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🏎️ Sim Racing Force Feedback" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <Border Background="#22FFA000" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="ANALOG" FontSize="9" FontWeight="Bold" Foreground="#FFB300"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Heavy progressive hydraulic brake resistance on L2, dynamic engine throttle vibration on R2, and raw linear stick curves." FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick Pro Feature Overrides -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Virtual Hall-Effect Stick Noise Stabilizer" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Suppresses micro-potentiometer jitter without adding input delay" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleSetupHall" Style="{StaticResource SetupToggle}" IsChecked="True" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== STEP 3: AUDIO, TOUCHPAD & DISPLAY ==================== -->
                <StackPanel x:Name="PanelStep3" Visibility="Collapsed">
                    <TextBlock Text="3. Audio Haptics, Touchpad &amp; Header Display" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4"/>
                    <TextBlock Text="Customize voice-coil bass haptics, touchpad behavior, and top-bar clock &amp; telemetry display." FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Audio-to-Haptics Reactive Sub-Bass Engine" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Converts real-time PC game audio bass into physical DualSense palm voice-coil vibration" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleSetupAudioHaptics" Style="{StaticResource SetupToggle}" IsChecked="True" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Touchpad Desktop Mouse &amp; Haptic Scroll Detents" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Use the capacitive touchpad as a desktop cursor with tactile scroll-wheel detents" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleSetupTouchMouse" Style="{StaticResource SetupToggle}" IsChecked="True" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show 1000Hz Kernel Latency &amp; Nerd Stats in Header" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Displays live USB/BT polling frequency and sub-millisecond frame timing in the top bar" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleSetupNerdStats" Style="{StaticResource SetupToggle}" IsChecked="False" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Clock &amp; Calendar Date Format" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="Choose 12-hour or 24-hour military clock and preferred date style" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleSetupMilitary" Style="{StaticResource SetupToggle}" IsChecked="False" HorizontalAlignment="Right" ToolTip="24-Hour Military Time"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Date Layout:" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbSetupDateFormat" Width="170" SelectedIndex="0">
                                    <ComboBoxItem Content="Day + DD/MM (Sun 01/11)" Tag="ddd dd/MM"/>
                                    <ComboBoxItem Content="Day + MM/DD (Sun 11/01)" Tag="ddd MM/dd"/>
                                    <ComboBoxItem Content="ISO Date (2026-11-01)" Tag="yyyy-MM-dd"/>
                                    <ComboBoxItem Content="Time Only (No Date)" Tag="None"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

            <!-- FOOTER BAR -->
            <Border Grid.Row="2" Background="#0C121F" CornerRadius="0,0,15,15" BorderBrush="#1A253B" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid>
                    <Button x:Name="BtnSkipSetup" Content="Skip Setup" Style="{StaticResource StepBtn}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="BtnSkip_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnPrevStep" Content="← Back" Style="{StaticResource StepBtn}" Visibility="Collapsed" Margin="0,0,10,0" Click="BtnPrevStep_Click"/>
                        <Button x:Name="BtnNextStep" Content="Next Step →" Style="{StaticResource StepBtn}" Background="#00F5D4" Foreground="#080B13" BorderBrush="#00F5D4" Click="BtnNextStep_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
