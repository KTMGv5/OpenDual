<Window x:Class="OpenDualHub.OverclockAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1000 Hz USB Polling Rate Overclocking Assistant - OpenDual"
        Icon="Assets/app.ico"
        Height="760" Width="880"
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#0A0D14"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#141A28"/>
        <SolidColorBrush x:Key="SlotBg" Color="#0D111A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#222B3F"/>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#7C4DFF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFA000"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C9BB0"/>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#222B3F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#32405D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F3C57"/>
                    <Setter Property="BorderBrush" Value="#00F5D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#2A1B4E"/>
            <Setter Property="BorderBrush" Value="#7C4DFF"/>
            <Setter Property="Foreground" Value="#EDE7F6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B266D"/>
                    <Setter Property="BorderBrush" Value="#B388FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#133324"/>
            <Setter Property="BorderBrush" Value="#00E676"/>
            <Setter Property="Foreground" Value="#E8F5E9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B4D36"/>
                    <Setter Property="BorderBrush" Value="#69F0AE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource AccentSignature}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="1000 Hz USB Polling Rate Overclocking Assistant" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="DualSense defaults to 250 Hz (4.0ms) over USB on PC. Overclocking to 1000 Hz cuts input latency down to 1.0ms for esports responsiveness." FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <Border x:Name="PillLiveRate" Grid.Column="1" Background="#261C08" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotRateIndicator" Width="8" Height="8" Fill="{StaticResource AccentAmber}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRateHeaderStatus" Text="250 Hz (4.0 ms) • Default" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Scrollable Content Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- Real-Time Telemetry & Benchmark Card -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="REAL-TIME TELEMETRY &amp; BENCHMARK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CURRENT POLLING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BenchHz" Text="250 Hz" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="BenchInterval" Text="4.0 ms interval" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="INPUT LATENCY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BenchLatency" Text="4.0 ms" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="BenchLatencyDiff" Text="Esports target: 1.0 ms" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="MIN / MAX LATENCY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BenchMinMax" Text="3.8 / 4.2 ms" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="BenchAvg" Text="Avg: 4.0 ms" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="FILTER SERVICE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BenchFilterStatus" Text="Not Installed" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="BenchDeviceFilter" Text="VID 054C : PID 0CE6" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 1-Click Action Hub -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1-CLICK AUTOMATION HUB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,10"/>
                        <TextBlock Text="OpenDual can automatically download SweetLow's official driver package and launch the setup tool with Administrator privileges." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnDownloadHidusbf" Content="📥 1-Click Download SweetLow HIDUSBF" Style="{StaticResource AccentBtn}" Margin="0,0,10,8" Click="BtnDownloadHidusbf_Click"/>
                            <Button x:Name="BtnInstallCert" Content="🔑 Install Driver Certificate (Admin)" Style="{StaticResource ModernBtn}" Margin="0,0,10,8" Click="BtnInstallCert_Click"/>
                            <Button x:Name="BtnLaunchSetup" Content="🚀 Launch SweetLow Setup (Admin)" Style="{StaticResource SuccessBtn}" Margin="0,0,10,8" Click="BtnLaunchSetup_Click"/>
                            <Button x:Name="BtnCoreIsolation" Content="🛡️ Core Isolation Settings" Style="{StaticResource ModernBtn}" Margin="0,0,0,8" Click="BtnCoreIsolation_Click" ToolTip="Open Windows Memory Integrity settings if Windows blocks the driver"/>
                        </WrapPanel>

                        <!-- Progress Bar & Status Text -->
                        <ProgressBar x:Name="ProgressDownload" Height="6" Background="{StaticResource SlotBg}" Foreground="{StaticResource AccentSignature}" Visibility="Collapsed" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtActionStatus" Text="Ready: Click 1-Click Download or Launch Setup to begin." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Step-by-Step Guided Instructions -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP-BY-STEP OVERCLOCKING GUIDE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,12"/>

                        <!-- Step 1 -->
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" Background="#1E2A40" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock Text="1" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Download SweetLow HIDUSBF" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Click the '1-Click Download' button above. OpenDual downloads the official SweetLow driver archive directly into your OpenDual tools directory." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 2 -->
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" Background="#1E2A40" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock Text="2" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Install Driver Certificate (Admin)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Click 'Install Driver Certificate'. On 64-bit Windows 10 &amp; 11, this adds SweetLow's signing certificate to your system so the filter driver loads without security warnings." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 3 -->
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" Background="#1E2A40" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock Text="3" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Launch SweetLow Setup &amp; Configure DualSense" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Click 'Launch SweetLow Setup (Admin)'. When the tool opens:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,4"/>
                                    <BulletDecorator Margin="6,2,0,2">
                                        <TextBlock Text="• In the top drop-down menu, change 'Mice' to 'All'." FontSize="11" Foreground="#EDE7F6"/>
                                    </BulletDecorator>
                                    <BulletDecorator Margin="6,2,0,2">
                                        <TextBlock Text="• Find and click on 'Wireless Controller' (Hardware ID: VID_054C&amp;PID_0CE6)." FontSize="11" Foreground="#EDE7F6"/>
                                    </BulletDecorator>
                                    <BulletDecorator Margin="6,2,0,2">
                                        <TextBlock Text="• Put a checkmark in the 'Filter On Device' checkbox." FontSize="11" Foreground="#EDE7F6"/>
                                    </BulletDecorator>
                                    <BulletDecorator Margin="6,2,0,2">
                                        <TextBlock Text="• Change the 'Selected Rate' dropdown from 'Default' to '1000' (1ms)." FontSize="11" Foreground="#00F5D4" FontWeight="Bold"/>
                                    </BulletDecorator>
                                    <BulletDecorator Margin="6,2,0,2">
                                        <TextBlock Text="• Click the 'Install Service' button." FontSize="11" Foreground="#EDE7F6"/>
                                    </BulletDecorator>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 4 -->
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" Background="#1E2A40" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock Text="4" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Unplug and Replug USB Cable" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Unplug your DualSense controller USB cable and plug it back in. Windows re-enumerates the device with the 1000 Hz filter active. OpenDual will immediately detect the 1000 Hz stream!" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Windows 11 Note: If the driver fails to load, toggle Memory Integrity in Core Isolation settings." FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Done" Style="{StaticResource ModernBtn}" Padding="24,6" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
