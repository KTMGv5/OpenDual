        <SolidColorBrush x:Key="AccentMagenta" Color="#E040FB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C9BB0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#332979FF"/>
        <SolidColorBrush x:Key="PillBg" Color="#25162033"/>
        <SolidColorBrush x:Key="BgCard" Color="#CC0E1422"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#E6162033"/>
