<Window x:Class="OpenDualHub.CaptureBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDual Create Capture Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="900" MinHeight="170"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgRoot" Color="#0B0E17"/>
        <SolidColorBrush x:Key="BgCard" Color="#121824"/>
        <SolidColorBrush x:Key="BgActive" Color="#182438"/>
        <SolidColorBrush x:Key="BorderNormal" Color="#222B3F"/>
        <SolidColorBrush x:Key="BorderActive" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF334B"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C9BB0"/>

        <Style x:Key="CaptureTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="86"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="OuterGrid" Margin="24">
        <!-- Scale Transform Root -->
        <Border x:Name="BarRoot"
                Background="{StaticResource BgRoot}"
                BorderBrush="{StaticResource BorderNormal}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,14"
                Width="920"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.LayoutTransform>
                <ScaleTransform x:Name="BarScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.LayoutTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: Header with PlayStation Create Icon & Status -->
                <Grid Grid.Row="0" Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Create / Share Icon (Three radiating rays) -->
                        <Border Width="24" Height="24" Background="#1E00F5D4" BorderBrush="#6600F5D4" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="≡" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <TextBlock Text="CREATE / CAPTURE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" VerticalAlignment="Center"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtActiveGame" Text="Windows Desktop" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center Notification / Confirmation Text -->
                    <TextBlock x:Name="TxtNotification" Grid.Column="0" Grid.ColumnSpan="3" Text="" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                    <!-- Right Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBufferNotice" Text="Instant Replay: 30s" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="(O / Share) Close" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: The 5 Capture Tiles -->
                <Grid Grid.Row="1" Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tile 0: Screenshot -->
                    <Border x:Name="Tile0" Grid.Column="0" Style="{StaticResource CaptureTile}" Margin="0,0,8,0" MouseLeftButtonDown="Tile0_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📸 SCREENSHOT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Capture screen" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,6"/>
                            <Border Background="#1C2536" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="(X) Take Shot" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tile 1: Save Recent Clip -->
                    <Border x:Name="Tile1" Grid.Column="1" Style="{StaticResource CaptureTile}" Margin="0,0,8,0" MouseLeftButtonDown="Tile1_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⏱️ SAVE CLIP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="TxtClipDuration" Text="Last 30s (▲/▼ change)" FontSize="10" Foreground="{StaticResource AccentAmber}" Margin="0,2,0,6"/>
                            <Border Background="#1C2536" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="(X) Save Replay" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tile 2: Start / Stop Recording -->
                    <Border x:Name="Tile2" Grid.Column="2" Style="{StaticResource CaptureTile}" Margin="0,0,8,0" MouseLeftButtonDown="Tile2_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🔴 RECORD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Start / Stop DVR" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,6"/>
                            <Border Background="#1C2536" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="(X) Toggle (Win+Alt+R)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tile 3: Xbox Game Bar Overlay -->
                    <Border x:Name="Tile3" Grid.Column="3" Style="{StaticResource CaptureTile}" Margin="0,0,8,0" MouseLeftButtonDown="Tile3_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🎮 GAME BAR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Full PC overlay" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,6"/>
                            <Border Background="#1C2536" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="(X) Open (Win+G)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tile 4: Gallery / Captures Folder -->
                    <Border x:Name="Tile4" Grid.Column="4" Style="{StaticResource CaptureTile}" MouseLeftButtonDown="Tile4_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📁 GALLERY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Videos\Captures" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,6"/>
                            <Border Background="#1C2536" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="(X) Open Folder" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW 2: Controller Shortcuts Navigation Guide -->
                <Border Grid.Row="2" Background="#0E121B" CornerRadius="8" Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="◀ / ▶ Move" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,14,0"/>
                            <TextBlock Text="▲ / ▼ Duration (Tile 1)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,14,0"/>
                            <TextBlock Text="(X) Confirm" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentSignature}" Margin="0,0,14,0"/>
                            <TextBlock Text="(O) Close" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Hold Share: Quick Screenshot • Double-Tap: Quick 30s Clip" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
