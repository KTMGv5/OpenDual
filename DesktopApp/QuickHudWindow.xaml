<Window x:Class="OpenDualHub.QuickHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDual Control Center"
        SizeToContent="WidthAndHeight"
        MinWidth="1080" MinHeight="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="HudBg" Color="#F20B0F19"/>
        <SolidColorBrush x:Key="HudBorder" Color="#4000F5D4"/>
        <SolidColorBrush x:Key="TileNormalBg" Color="#CC121824"/>
        <SolidColorBrush x:Key="TileNormalBorder" Color="#33243046"/>
        <SolidColorBrush x:Key="TileSelectedBg" Color="#2E00F5D4"/>
        <SolidColorBrush x:Key="TileSelectedBorder" Color="#FF00F5D4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C9BB0"/>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFB300"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0070D1"/>
    </Window.Resources>

    <Grid Margin="24">
        <Border x:Name="HudRoot" Width="1060" MinHeight="192" Background="{StaticResource HudBg}" BorderBrush="{StaticResource HudBorder}" BorderThickness="1.5" CornerRadius="24" Padding="22,14" Opacity="0">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="HudScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.85"/>
            </Border.Effect>

            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Status Strip (Header, Latency, Clock, Battery, Mini Haptic Meters) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Interactive Tiles (5 Tiles) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Bottom Navigation Bar Hint -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP STATUS BAR -->
                <Grid Grid.Row="0" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: PS Logo & Controller -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="#1E00F5D4" BorderBrush="#6600F5D4" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Text="PS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtControllerName" Text="DualSense Wireless" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtConnection" Text="1000Hz (1.0ms) • USB" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSignature}" VerticalAlignment="Center" MinWidth="180"/>
                    </StackPanel>

                    <!-- Center: Clock (Centered across entire HUD width, locked dead center regardless of left/right text) -->
                    <TextBlock x:Name="TxtClock" Grid.Column="0" Grid.ColumnSpan="3" Text="8:45 PM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                    <!-- Right: Battery & Stereo Tactile Mini-Meters -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Battery -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtBatteryPercent" Text="85%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtChargingBadge" Text=" ⚡" FontSize="11" Foreground="{StaticResource AccentSignature}" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Mini Haptic Rumble Meters -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Live Stereo Voice-Coil Vibration">
                            <TextBlock Text="HAPTICS " FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ProgressBar x:Name="BarMiniHapticL" Width="32" Height="8" Minimum="0" Maximum="255" Value="0" Background="#1A2333" Foreground="{StaticResource AccentSignature}" BorderThickness="0" Margin="2,0"/>
                            <ProgressBar x:Name="BarMiniHapticR" Width="32" Height="8" Minimum="0" Maximum="255" Value="0" Background="#1A2333" Foreground="{StaticResource AccentBlue}" BorderThickness="0" Margin="2,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: 5 INTERACTIVE TILES -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TILE 0: ACTIVE GAME & PROFILE -->
                    <Border x:Name="Tile0" Tag="0" Cursor="Hand" MouseLeftButtonDown="Tile_MouseLeftButtonDown" Grid.Column="0" Background="{StaticResource TileSelectedBg}" BorderBrush="{StaticResource TileSelectedBorder}" BorderThickness="2" CornerRadius="12" Margin="4,0" Padding="12,10" MinHeight="92">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮 PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTileGameName" Text="Minecraft.exe" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtTileProfileName" Text="Competitive FPS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSignature}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtTileTriggersMode" Text="L2: Hair • R2: Pulse" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- TILE 1: MASTER AUDIO & MIC -->
                    <Border x:Name="Tile1" Tag="1" Cursor="Hand" MouseLeftButtonDown="Tile_MouseLeftButtonDown" Grid.Column="1" Background="{StaticResource TileNormalBg}" BorderBrush="{StaticResource TileNormalBorder}" BorderThickness="1.5" CornerRadius="12" Margin="4,0" Padding="12,10" MinHeight="92">
                        <StackPanel VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="🔉 MASTER AUDIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                                <TextBlock x:Name="TxtTileVolumePercent" Text="75%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="BarTileVolume" Height="6" Minimum="0" Maximum="100" Value="75" Background="#1A2333" Foreground="{StaticResource AccentSignature}" BorderThickness="0" Margin="0,6,0,4"/>
                            <TextBlock x:Name="TxtTileAudioDevice" Text="DualSense Speakers" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtTileMicBadge" Text="🎙️ MIC: ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- TILE 2: 6-AXIS GYRO AIMING -->
                    <Border x:Name="Tile2" Tag="2" Cursor="Hand" MouseLeftButtonDown="Tile_MouseLeftButtonDown" Grid.Column="2" Background="{StaticResource TileNormalBg}" BorderBrush="{StaticResource TileNormalBorder}" BorderThickness="1.5" CornerRadius="12" Margin="4,0" Padding="12,10" MinHeight="92">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🎯 GYRO AIMING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            <TextBlock x:Name="TxtTileGyroState" Text="ADS TRIGGER (L2)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtTileGyroSens" Text="Sens: 1.0x (Yaw/Pitch)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSignature}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtTileGyroStatus" Text="Sub-Pixel Mouse (Active)" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- TILE 3: PC HARDWARE SPECS -->
                    <Border x:Name="Tile3" Tag="3" Cursor="Hand" MouseLeftButtonDown="Tile_MouseLeftButtonDown" Grid.Column="3" Background="{StaticResource TileNormalBg}" BorderBrush="{StaticResource TileNormalBorder}" BorderThickness="1.5" CornerRadius="12" Margin="4,0" Padding="12,10" MinHeight="92">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="💻 PC HARDWARE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            <TextBlock x:Name="TxtTileCpuUsage" Text="CPU: 14%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="TxtTileRamUsage" Text="RAM: 42% (13.4 GB)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSignature}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtTileRamTotal" Text="Total: 31.9 GB DDR" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- TILE 4: CONTROLLER & TOUCHPAD -->
                    <Border x:Name="Tile4" Tag="4" Cursor="Hand" MouseLeftButtonDown="Tile_MouseLeftButtonDown" Grid.Column="4" Background="{StaticResource TileNormalBg}" BorderBrush="{StaticResource TileNormalBorder}" BorderThickness="1.5" CornerRadius="12" Margin="4,0" Padding="12,10" MinHeight="92">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⚡ TOUCHPAD &amp; HAPTICS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            <TextBlock x:Name="TxtTileTouchpadSens" Text="Touchpad: 1.2x" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="TxtTileTouchpadMode" Text="Precision Notch: ON" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSignature}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtTileHapticsSummary" Text="Haptics: 100% (Punchy)" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW 2: CONTROLLER NAVIGATION GUIDE -->
                <Grid Grid.Row="2" Margin="0,2,0,2">
                    <TextBlock x:Name="TxtNavGuide" Text="D-Pad ◄► Select Tile   •   ▲▼ Cycle Profile   •   ✕ Apply Profile   •   □ Mic Mute   •   R3 Scale   •   ○ / PS Close" FontSize="10.5" FontWeight="SemiBold" Foreground="#8898B0" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
