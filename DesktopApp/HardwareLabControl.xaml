<UserControl x:Class="OpenDualHub.HardwareLabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenDualHub"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="680">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF334B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2979FF"/>
        <SolidColorBrush x:Key="AccentMagenta" Color="#FF007F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C9BB0"/>
        <SolidColorBrush x:Key="BgCard" Color="#D90E1422"/>
        <SolidColorBrush x:Key="BorderColor" Color="#302979FF"/>
        <SolidColorBrush x:Key="SlotBg" Color="#BF090D15"/>

        <Style x:Key="LabBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#402979FF"/>
            <Setter Property="Background" Value="#1C2740"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="LabScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:SmoothScrollHelper.SmoothScroll="True">
        <StackPanel Margin="4">

            <!-- 1. TOP HEADER BANNER -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" Background="#2600F5D4" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                <TextBlock Text="🔬" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ESPORTS HARDWARE DIAGNOSTIC LAB" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Real-time 3D spatial gimbal, stick circularity benchmarker, zero-shift drift eliminator, and trigger oscilloscope." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="32,2,0,0"/>
                    </StackPanel>

                    <!-- Top Quick Metrics -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="POLLING JITTER" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtTopJitter" Text="±0.03 ms" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="CIRCULARITY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtTopCircError" Text="3.8% Pro" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <StackPanel>
                                <TextBlock Text="ZERO-SHIFT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtTopZeroShift" Text="Ready (0.00)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. REAL-TIME 3D SPATIAL GIMBAL -->
            <Border x:Name="CardGimbal" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="3D SPATIAL GIMBAL &amp; 6-AXIS IMU" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1A2979FF" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGimbalAngles" Text="Yaw: +0.0°  Pitch: +0.0°  Roll: +0.0°" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                        </Border>
                        <Button x:Name="BtnRecenterGimbal" Grid.Column="2" Content="Recenter View" Style="{StaticResource LabBtnStyle}" Padding="10,4" FontSize="10" Click="BtnRecenterGimbal_Click"/>
                    </Grid>

                    <!-- 3D Viewport Area -->
                    <Border Height="200" Background="#0A0E17" BorderBrush="#202979FF" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Viewport3D x:Name="ViewportController" IsHitTestVisible="False">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera Position="0, -1.9, 3.8" LookDirection="0, 1.75, -3.8" UpDirection="0, 1, 0" FieldOfView="82"/>
                                </Viewport3D.Camera>

                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <AmbientLight Color="#687285"/>
                                            <DirectionalLight Color="#FFFFFF" Direction="-0.6, 0.8, -1.5"/>
                                            <DirectionalLight Color="#00F5D4" Direction="1.0, 0.5, 0.8"/>
                                            <DirectionalLight Color="#2979FF" Direction="-1.0, -0.5, 0.8"/>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>

                                <ModelVisual3D x:Name="VisualControllerGroup">
                                    <ModelVisual3D.Transform>
                                        <Transform3DGroup>
                                            <!-- Extrinsic/Intrinsic 3D Gimbal: Roll (Y forward), Pitch (X right), Yaw (Z up) -->
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="RotRoll" Axis="0, 1, 0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="RotPitch" Axis="1, 0, 0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="RotYaw" Axis="0, 0, 1" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </Transform3DGroup>
                                    </ModelVisual3D.Transform>
                                </ModelVisual3D>
                            </Viewport3D>

                            <!-- G-Force Accelerometer overlay -->
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                                <Border Background="#CC090D15" CornerRadius="6" Padding="8,3" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="G-FORCE: " FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtGForce" Text="X: +0.01G   Y: -0.99G   Z: +0.03G" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. STICK CIRCULARITY & ZERO-SHIFT DRIFT ELIMINATOR -->
            <Border x:Name="CardCircularity" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STICK CIRCULARITY &amp; ZERO-SHIFT BENCHMARK" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnZeroShift" Content="Zero-Shift (Fix Drift)" Style="{StaticResource LabBtnStyle}" Background="{StaticResource AccentAmber}" Foreground="#0A0E17" Margin="0,0,6,0" Click="BtnZeroShift_Click"/>
                            <Button x:Name="BtnResetCirc" Content="Reset Radar" Style="{StaticResource LabBtnStyle}" Click="BtnResetCirc_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dual Radars (Left & Right Sticks) -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Stick Radar -->
                        <Border Grid.Column="0" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="LEFT ANALOG (L3)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Canvas x:Name="CanvasRadarL" Width="120" Height="120" Background="#0C101A" ClipToBounds="True"/>
                                <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCircErrorL" Text="Avg Error: 3.8%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDriftL" Text="Rest Offset: 0.00 (Zero Drift)" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right Stick Radar -->
                        <Border Grid.Column="2" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="RIGHT ANALOG (R3)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Canvas x:Name="CanvasRadarR" Width="120" Height="120" Background="#0C101A" ClipToBounds="True"/>
                                <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCircErrorR" Text="Avg Error: 4.1%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDriftR" Text="Rest Offset: 0.00 (Zero Drift)" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. ADAPTIVE TRIGGER RESISTANCE & FORCE OSCILLOSCOPE -->
            <Border x:Name="CardTriggers" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ADAPTIVE TRIGGER MOTOR OSCILLOSCOPE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTriggerEngineStatus" Grid.Column="1" Text="Motors: 100% Ready" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Trigger (L2) -->
                        <Border Grid.Column="0" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="L2 AIM / BRAKE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtL2Travel" Text="0.0% (0.0mm)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarL2Depth" Height="6" Minimum="0" Maximum="100" Value="0" Background="#141B2B" Foreground="{StaticResource AccentSignature}" BorderThickness="0"/>
                                <Canvas x:Name="CanvasL2Curve" Height="40" Background="#0C101A" Margin="0,6,0,0" ClipToBounds="True"/>
                                <TextBlock x:Name="TxtL2ModeDesc" Text="Mode: Rigid Section Barrier (Click Snap)" FontSize="8.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Trigger (R2) -->
                        <Border Grid.Column="2" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="R2 FIRE / THROTTLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtR2Travel" Text="0.0% (0.0mm)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarR2Depth" Height="6" Minimum="0" Maximum="100" Value="0" Background="#141B2B" Foreground="{StaticResource AccentSignature}" BorderThickness="0"/>
                                <Canvas x:Name="CanvasR2Curve" Height="40" Background="#0C101A" Margin="0,6,0,0" ClipToBounds="True"/>
                                <TextBlock x:Name="TxtR2ModeDesc" Text="Mode: Game Specific Adaptive Profile" FontSize="8.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. 1000Hz POLLING LATENCY JITTER HISTOGRAM -->
            <Border x:Name="CardJitter" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="1000Hz POLLING JITTER &amp; PACKET LOSS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPacketLoss" Grid.Column="1" Text="Packet Drops: 0 (100% Signal)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Canvas x:Name="CanvasJitter" Height="50" Background="#0A0E17" ClipToBounds="True"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="INSTANT LATENCY" FontSize="8" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtInstantLatency" Text="1.00 ms" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="JITTER STD DEV (σ)" FontSize="8" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtJitterStdDev" Text="±0.04 ms" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STABILITY SCORE" FontSize="8" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtStabilityScore" Text="99.9% Esports" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
