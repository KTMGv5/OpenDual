<Window x:Class="OpenDualHub.GyroCalibratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interactive Gyro Aiming Calibrator"
        Width="1050" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F20A0E17"
        BorderBrush="#4000F5D4"
        BorderThickness="1.5"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFB300"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C9BB0"/>
        <SolidColorBrush x:Key="BgCard" Color="#121824"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1F283B"/>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0A0E17"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Interactive Calibration Arena -->
            <RowDefinition Height="*"/>
            <!-- Bottom Telemetry Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#161F30" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#2200F5D4" BorderBrush="#8800F5D4" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="🎯" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="INTERACTIVE GYRO AIMING CALIBRATOR" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Physically aim your controller at each target and press Cross (X) to lock the point." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step Badge -->
                <Border x:Name="BadgeStep" Grid.Column="1" HorizontalAlignment="Center" Background="#1A00F5D4" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" CornerRadius="12" Padding="14,4">
                    <TextBlock x:Name="TxtStepIndicator" Text="TARGET 1 OF 5: CENTER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                </Border>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="✕" Width="30" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- INTERACTIVE CANVAS ARENA -->
        <Grid Grid.Row="1">
            <Canvas x:Name="CalibCanvas" Background="#0C101B" ClipToBounds="True">
                <!-- Grid background lines -->
                <Line X1="0" Y1="270" X2="1050" Y2="270" Stroke="#162035" StrokeThickness="1" StrokeDashArray="4 4"/>
                <Line X1="525" Y1="0" X2="525" Y2="540" Stroke="#162035" StrokeThickness="1" StrokeDashArray="4 4"/>

                <!-- Active Target Bullseye -->
                <Grid x:Name="TargetBullseye" Width="90" Height="90" Canvas.Left="480" Canvas.Top="225">
                    <!-- Outer Ring -->
                    <Ellipse Stroke="{StaticResource AccentSignature}" StrokeThickness="2" Width="90" Height="90" Opacity="0.8"/>
                    <!-- Middle Ring -->
                    <Ellipse Stroke="{StaticResource AccentSignature}" StrokeThickness="1.5" Width="56" Height="56" StrokeDashArray="3 3"/>
                    <!-- Inner Bullseye -->
                    <Ellipse x:Name="BullseyeCenter" Fill="{StaticResource AccentSignature}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- Cross ticks -->
                    <Line X1="0" Y1="45" X2="90" Y2="45" Stroke="{StaticResource AccentSignature}" StrokeThickness="1" Opacity="0.5"/>
                    <Line X1="45" Y1="0" X2="45" Y2="90" Stroke="{StaticResource AccentSignature}" StrokeThickness="1" Opacity="0.5"/>
                </Grid>

                <!-- Gyro Aim Reticle (Player Crosshair) -->
                <Canvas x:Name="ReticleCanvas" Width="50" Height="50" Canvas.Left="500" Canvas.Top="245">
                    <!-- Outer Crosshair Circle -->
                    <Ellipse Width="40" Height="40" Canvas.Left="5" Canvas.Top="5" Stroke="{StaticResource AccentGreen}" StrokeThickness="2"/>
                    <!-- Center Dot -->
                    <Ellipse x:Name="ReticleDot" Width="8" Height="8" Canvas.Left="21" Canvas.Top="21" Fill="{StaticResource AccentGreen}"/>
                    <!-- Crosshair Ticks -->
                    <Line X1="25" Y1="0" X2="25" Y2="12" Stroke="{StaticResource AccentGreen}" StrokeThickness="2"/>
                    <Line X1="25" Y1="38" X2="25" Y2="50" Stroke="{StaticResource AccentGreen}" StrokeThickness="2"/>
                    <Line X1="0" Y1="25" X2="12" Y2="25" Stroke="{StaticResource AccentGreen}" StrokeThickness="2"/>
                    <Line X1="38" Y1="25" X2="50" Y2="25" Stroke="{StaticResource AccentGreen}" StrokeThickness="2"/>
                </Canvas>
            </Canvas>

            <!-- Results Card Overlay (Shown upon completing 5 targets) -->
            <Border x:Name="PanelResults" Background="#F00B0F19" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1.5" CornerRadius="16" Width="640" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.85"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🎯 CALIBRATION COMPLETE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Zero-drift offset eliminated and optimal sensitivities calculated for your display." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Stat 1: Drift Offset -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#161F30" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="ZERO-RATE DRIFT" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtDriftBias" Text="0.00 deg/s (Eliminated)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Stat 2: Horizontal Sens -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#161F30" CornerRadius="8" Padding="14" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="OPTIMAL SENSITIVITY (X)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtSensX" Text="1.25x" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Stat 3: Vertical Sens -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#161F30" CornerRadius="8" Padding="14" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="OPTIMAL SENSITIVITY (Y)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtSensY" Text="1.25x" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Stat 4: Deadzone -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#161F30" CornerRadius="8" Padding="14" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="ANTI-JITTER DEADZONE" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtDeadzone" Text="0.04 (Stabilized)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnApplyCalibration" Content="Save &amp; Apply to Controller" Style="{StaticResource PrimaryBtnStyle}" Background="{StaticResource AccentSignature}" Margin="0,0,12,0" Click="BtnApplyCalibration_Click"/>
                        <Button x:Name="BtnRestart" Content="Recalibrate" Style="{StaticResource PrimaryBtnStyle}" Background="#2A374F" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0" Click="BtnRestart_Click"/>
                        <Button x:Name="BtnDone" Content="Done" Style="{StaticResource PrimaryBtnStyle}" Background="#1F283B" Foreground="{StaticResource TextSecondary}" Click="BtnClose_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOTTOM TELEMETRY BAR -->
        <Border Grid.Row="2" Background="#121824" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Live Angles -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Live Motion: " FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="TxtLiveAngles" Text="Yaw: +0.0°  |  Pitch: +0.0°" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <!-- Live Prompt -->
                <TextBlock x:Name="TxtPrompt" Grid.Column="1" Text="Center the reticle on the target and press Cross (✕) on your controller" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentAmber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Cross Button Indicator -->
                <Border x:Name="PillCross" Grid.Column="2" Background="#1A00E676" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPillCross" Text="CROSS (✕) READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>