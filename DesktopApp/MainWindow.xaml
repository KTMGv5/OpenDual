<Window x:Class="OpenDualHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDual — PlayStation Controller Suite"
        Icon="Assets/app.ico"
        Height="820" Width="1100"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Theme Brushes (Default PS5) -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0A0D14"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#121622"/>
        <SolidColorBrush x:Key="BgCard" Color="#181F2E"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#222B3F"/>
        <SolidColorBrush x:Key="InputBg" Color="#131824"/>
        <SolidColorBrush x:Key="InputBorder" Color="#28354D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C9BB0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#243046"/>
        <SolidColorBrush x:Key="SlotBg" Color="#0E121A"/>
        <SolidColorBrush x:Key="PillBg" Color="#1F283B"/>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="HeaderAccent" Color="#0070D1"/>

        <!-- Standard Accents -->
        <SolidColorBrush x:Key="AccentBlue" Color="#0070D1"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentMagenta" Color="#FF007F"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF334B"/>

        <!-- Modern Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource HeaderAccent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox ToggleButton -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentSignature}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern High-Contrast ComboBox Style (No AI emojis) -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgCardHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HeaderAccent}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PS5 Top Navigation Ribbon Tab Style -->
        <Style x:Key="PS5NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="HoverBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Active indicator underline bar (PS5 style) -->
                            <Border x:Name="ActiveBar" Height="3" VerticalAlignment="Bottom" Background="{DynamicResource AccentSignature}" CornerRadius="1.5" Visibility="Collapsed" Margin="6,0,6,-2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="{DynamicResource BgCardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HeaderAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#33FFFFFF" CornerRadius="4" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSignature}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HeaderAccent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- PS5 HOMESCREEN TOP NAVIGATION BAR -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: OpenDual Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Source="Assets/logo.png" Width="30" Height="30" Margin="0,0,8,0"/>
                    <TextBlock Text="OpenDual" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SUITE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}"/>
                    </Border>
                </StackPanel>

                <!-- Center: Navigation Ribbon Tabs (Smoothly scrollable, zero clipping) -->
                <ScrollViewer x:Name="NavTabsScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" PanningMode="HorizontalOnly" PreviewMouseWheel="NavTabsScrollViewer_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <RadioButton x:Name="TabController" Content="CONTROLLER" Style="{StaticResource PS5NavTabStyle}" IsChecked="True" Checked="Nav_Dashboard_Checked"/>
                        <RadioButton x:Name="TabLightbar" Content="LIGHTBAR" Style="{StaticResource PS5NavTabStyle}" Checked="Nav_Rgb_Checked"/>
                        <RadioButton x:Name="TabTriggers" Content="TRIGGERS" Style="{StaticResource PS5NavTabStyle}" Checked="Nav_Triggers_Checked"/>
                        <RadioButton x:Name="TabGyro" Content="GYRO AIM" Style="{StaticResource PS5NavTabStyle}" Checked="Nav_Gyro_Checked"/>
                        <RadioButton x:Name="TabTouchpad" Content="TOUCHPAD" Style="{StaticResource PS5NavTabStyle}" Checked="Nav_Touchpad_Checked"/>
                        <RadioButton x:Name="TabAudio" Content="AUDIO" Style="{StaticResource PS5NavTabStyle}" Checked="Nav_Audio_Checked"/>
                        <RadioButton x:Name="TabProfiles" Content="PROFILES" Style="{StaticResource PS5NavTabStyle}" Checked="Nav_Profiles_Checked"/>
                        <RadioButton x:Name="TabSystem" Content="SYSTEM" Style="{StaticResource PS5NavTabStyle}" Checked="Nav_Driver_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Global Clock & Battery Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- Real-Time Digital Clock -->
                    <TextBlock x:Name="TxtClock" Text="12:00 PM" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- Battery & Connection Indicator -->
                    <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="9,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentRed}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBatteryHeader" Text="100%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA WITH AUTO SCROLLING -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="18,14,18,20">
            
            <!-- 1. CONTROLLER DASHBOARD VIEW -->
            <Grid x:Name="ViewDashboard" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Information Card -->
                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="DashModelTitle" Text="PlayStation 5 DualSense Wireless Controller" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border x:Name="DashProfileBadge" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource HeaderAccent}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="10,2,0,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDashProfileName" Text="PlayStation 5 Balanced" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}"/>
                                </Border>
                                <Border x:Name="DashBatteryLowBadge" Background="#33FF334B" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="8,2,0,2" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="CRITICAL BATTERY (&lt;15%)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                                </Border>
                                <Border x:Name="DashMicBadge" Background="#33FF9800" CornerRadius="4" Padding="6,2" Margin="8,2,0,2" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="MIC MUTED" FontSize="10" FontWeight="Bold" Foreground="#FFA726"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="DashConnInfo" Text="Active USB Connection • Direct Win32 Overlapped High-Priority Driver" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- Telemetry Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="POLLING RATE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}"/>
                                    <TextBlock x:Name="DashHzVal" Text="1000 Hz" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="INPUT LATENCY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource HeaderAccent}"/>
                                    <TextBlock x:Name="DashLatencyVal" Text="0.8 ms" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Visual Controller Canvas -->
                <Grid x:Name="GridDashContent" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DashColDefLeft" Width="1*"/>
                        <ColumnDefinition x:Name="DashColDefRight" Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Sticks & Triggers -->
                    <Border x:Name="DashLeftCol" Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ANALOG STICKS &amp; TRIGGERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>

                            <!-- Triggers L2 / R2 -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- L2 Trigger -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="L2 Trigger: " FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtL2Val" Text="0%" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="BarL2" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentSignature}" Background="{DynamicResource SlotBg}" BorderThickness="0"/>
                                </StackPanel>

                                <!-- R2 Trigger -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="R2 Trigger: " FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtR2Val" Text="0%" FontWeight="Bold" Foreground="{StaticResource AccentMagenta}"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="BarR2" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentMagenta}" Background="{DynamicResource SlotBg}" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sticks Vis (Canvas) -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Stick -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Left Stick" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Border Width="130" Height="130" CornerRadius="65" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="2">
                                        <Canvas Width="130" Height="130">
                                            <Line X1="65" Y1="10" X2="65" Y2="120" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"/>
                                            <Line X1="10" Y1="65" X2="120" Y2="65" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"/>
                                            <Ellipse x:Name="DotLS" Width="26" Height="26" Fill="{DynamicResource HeaderAccent}" Canvas.Left="52" Canvas.Top="52"/>
                                        </Canvas>
                                    </Border>
                                    <TextBlock x:Name="TxtLSCoord" Text="X: 0.00  Y: 0.00" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Right Stick -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Right Stick" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Border Width="130" Height="130" CornerRadius="65" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="2">
                                        <Canvas Width="130" Height="130">
                                            <Line X1="65" Y1="10" X2="65" Y2="120" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"/>
                                            <Line X1="10" Y1="65" X2="120" Y2="65" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"/>
                                            <Ellipse x:Name="DotRS" Width="26" Height="26" Fill="{StaticResource AccentMagenta}" Canvas.Left="52" Canvas.Top="52"/>
                                        </Canvas>
                                    </Border>
                                    <TextBlock x:Name="TxtRSCoord" Text="X: 0.00  Y: 0.00" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Buttons Status -->
                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Text="BUTTONS &amp; D-PAD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Border x:Name="PillL1" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="L1" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillR1" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="R1" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillShare" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="Create" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillOpt" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="Options" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillPS" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="PS" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillL3" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="L3" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillR3" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="R3" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillMic" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="Mute" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillFnL" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="Fn L" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillFnR" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="Fn R" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillPadL" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="Back LB" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillPadR" Background="{DynamicResource PillBg}" CornerRadius="4" Padding="10,4" Margin="4"><TextBlock Text="Back RB" FontSize="11" FontWeight="Bold"/></Border>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Touchpad & Action Buttons -->
                    <Border x:Name="DashRightCol" Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="TOUCHPAD SURFACE &amp; FACE BUTTONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>

                            <!-- Touchpad Visualizer -->
                            <TextBlock Text="Dual-Point Multi-Touch Surface (1920 x 1080)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Border Width="380" Height="200" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" CornerRadius="12" HorizontalAlignment="Center">
                                <Canvas x:Name="TouchpadCanvas" Width="380" Height="200" ClipToBounds="True">
                                    <Rectangle Width="380" Height="200" Fill="Transparent"/>
                                    <Line X1="285" Y1="0" X2="285" Y2="200" Stroke="{DynamicResource BorderColor}" StrokeDashArray="4,4" StrokeThickness="1"/>
                                    <Ellipse x:Name="DotTouch1" Width="18" Height="18" Fill="{DynamicResource AccentSignature}" Canvas.Left="-50" Canvas.Top="-50"/>
                                    <Ellipse x:Name="DotTouch2" Width="18" Height="18" Fill="{StaticResource AccentMagenta}" Canvas.Left="-50" Canvas.Top="-50"/>
                                </Canvas>
                            </Border>
                            <TextBlock x:Name="TxtTouchCoords" Text="Touch 1: Inactive | Touch 2: Inactive" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,16"/>

                            <!-- PlayStation Face Buttons -->
                            <TextBlock Text="ACTION BUTTONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,10"/>
                            <Grid HorizontalAlignment="Center" Width="200">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="45"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Triangle (Top) -->
                                <Border x:Name="BtnTriangle" Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PillBg}">
                                    <TextBlock Text="▲" Foreground="#00E676" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Square (Left) -->
                                <Border x:Name="BtnSquare" Grid.Row="1" Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PillBg}">
                                    <TextBlock Text="■" Foreground="#FF3377" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Circle (Right) -->
                                <Border x:Name="BtnCircle" Grid.Row="1" Grid.Column="2" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PillBg}">
                                    <TextBlock Text="●" Foreground="#FF334B" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Cross (Bottom) -->
                                <Border x:Name="BtnCross" Grid.Row="2" Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PillBg}">
                                    <TextBlock Text="✕" Foreground="#3399FF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. RGB LIGHTBAR VIEW -->
            <Grid x:Name="ViewRgb" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Lightbar Illumination Studio" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Customize 24-bit RGB lighting, cycle animations, speed curves, and Player indicator LEDs." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,24"/>

                        <Grid x:Name="GridRgbContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="RgbColDefLeft" Width="1.2*"/>
                                <ColumnDefinition x:Name="RgbColDefRight" Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color Sliders & Controls -->
                            <StackPanel x:Name="RgbLeftCol" Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
                                <!-- Red -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="RED" FontWeight="Bold" Foreground="#FF5555" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" Value="0" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtValR" Grid.Column="2" Text="0" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Green -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="GREEN" FontWeight="Bold" Foreground="#55FF55" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderG" Grid.Column="1" Minimum="0" Maximum="255" Value="120" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtValG" Grid.Column="2" Text="120" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Blue -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="BLUE" FontWeight="Bold" Foreground="#5599FF" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderB" Grid.Column="1" Minimum="0" Maximum="255" Value="255" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtValB" Grid.Column="2" Text="255" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Effect Mode -->
                                <TextBlock Text="Lighting Effect Mode" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,6"/>
                                <ComboBox x:Name="ComboEffect" SelectedIndex="0" SelectionChanged="ComboEffect_SelectionChanged" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Solid Color"/>
                                    <ComboBoxItem Content="Breathing / Gentle Pulse"/>
                                    <ComboBoxItem Content="Rainbow Cycle (360° Spectrum)"/>
                                    <ComboBoxItem Content="Battery Level Gauge"/>
                                </ComboBox>

                                <!-- NEW: Glow Cycle Speed Slider -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Glow Cycle Speed" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderEffectSpeed" Grid.Column="1" Minimum="0.2" Maximum="3.0" Value="1.0" ValueChanged="EffectSpeed_ValueChanged"/>
                                    <TextBlock x:Name="TxtEffectSpeedVal" Grid.Column="2" Text="1.0x" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Player LEDs -->
                                <TextBlock Text="Player Indicator LEDs" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadioP1" Content="Player 1" GroupName="PlayerLeds" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0" Checked="PlayerLed_Checked"/>
                                    <RadioButton x:Name="RadioP2" Content="Player 2" GroupName="PlayerLeds" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0" Checked="PlayerLed_Checked"/>
                                    <RadioButton x:Name="RadioP3" Content="Player 3" GroupName="PlayerLeds" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0" Checked="PlayerLed_Checked"/>
                                    <RadioButton x:Name="RadioP4" Content="Player 4" GroupName="PlayerLeds" Foreground="{DynamicResource TextPrimary}" Checked="PlayerLed_Checked"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Live Color Preview & Presets -->
                            <StackPanel x:Name="RgbRightCol" Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="LIVE HARDWARE GLOW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <Border x:Name="ColorPreviewBox" Height="110" CornerRadius="10" Background="#0078FF" Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtHexCode" Text="#0078FF" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtGlowSub" Text="Active Color" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel>
                                    <Button Content="PlayStation Blue" Style="{StaticResource PrimaryBtnStyle}" Background="#0070D1" Margin="3" Click="PresetColor_Click" Tag="0,112,209"/>
                                    <Button Content="Cyber Cyan" Style="{StaticResource PrimaryBtnStyle}" Background="#00F5D4" Foreground="#000000" Margin="3" Click="PresetColor_Click" Tag="0,245,212"/>
                                    <Button Content="Neon Pink" Style="{StaticResource PrimaryBtnStyle}" Background="#FF007F" Margin="3" Click="PresetColor_Click" Tag="255,0,127"/>
                                    <Button Content="Crimson Red" Style="{StaticResource PrimaryBtnStyle}" Background="#FF2A2A" Margin="3" Click="PresetColor_Click" Tag="255,42,42"/>
                                    <Button Content="Emerald Green" Style="{StaticResource PrimaryBtnStyle}" Background="#00E676" Foreground="#000000" Margin="3" Click="PresetColor_Click" Tag="0,230,118"/>
                                    <Button Content="Pure White" Style="{StaticResource PrimaryBtnStyle}" Background="#E0E0E0" Foreground="#000000" Margin="3" Click="PresetColor_Click" Tag="255,255,255"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. ADAPTIVE TRIGGERS VIEW -->
            <Grid x:Name="ViewTriggers" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <TextBlock Text="DualSense Adaptive Triggers" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Configure stepper-motor force resistance, mechanical machine-gun recoil, and bow tension." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,24"/>

                        <Grid x:Name="GridTriggersContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TriggersColDefLeft" Width="1*"/>
                                <ColumnDefinition x:Name="TriggersColDefRight" Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Trigger (L2) -->
                            <Border x:Name="TriggersLeftCol" Grid.Row="0" Grid.Column="0" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LEFT TRIGGER (L2)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Mode Profile" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ComboLTMode" SelectedIndex="0" SelectionChanged="TriggerMode_Changed" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Off / Standard Pull"/>
                                        <ComboBoxItem Content="Hair Trigger (Instant Actuation)"/>
                                        <ComboBoxItem Content="Rigid Stop (Hard Barrier)"/>
                                        <ComboBoxItem Content="Recoil Pulse (Automatic)"/>
                                        <ComboBoxItem Content="Bow (Increasing Tension)"/>
                                    </ComboBox>

                                    <TextBlock Text="Resistance Start Position" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <Slider x:Name="SliderLTStart" Minimum="0" Maximum="255" Value="50" ValueChanged="TriggerMode_Changed" Margin="0,0,0,10"/>

                                    <TextBlock Text="Resistance Force" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <Slider x:Name="SliderLTForce" Minimum="0" Maximum="255" Value="180" ValueChanged="TriggerMode_Changed" Margin="0,0,0,10"/>

                                    <TextBlock Text="Vibration Frequency" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <Slider x:Name="SliderLTFreq" Minimum="0" Maximum="255" Value="120" ValueChanged="TriggerMode_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Trigger (R2) -->
                            <Border x:Name="TriggersRightCol" Grid.Row="0" Grid.Column="1" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="RIGHT TRIGGER (R2)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentMagenta}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Mode Profile" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ComboRTMode" SelectedIndex="0" SelectionChanged="TriggerMode_Changed" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Off / Standard Pull"/>
                                        <ComboBoxItem Content="Hair Trigger (Instant Actuation)"/>
                                        <ComboBoxItem Content="Rigid Stop (Hard Barrier)"/>
                                        <ComboBoxItem Content="Recoil Pulse (Automatic)"/>
                                        <ComboBoxItem Content="Bow (Increasing Tension)"/>
                                    </ComboBox>

                                    <TextBlock Text="Resistance Start Position" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <Slider x:Name="SliderRTStart" Minimum="0" Maximum="255" Value="50" ValueChanged="TriggerMode_Changed" Margin="0,0,0,10"/>

                                    <TextBlock Text="Resistance Force" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <Slider x:Name="SliderRTForce" Minimum="0" Maximum="255" Value="180" ValueChanged="TriggerMode_Changed" Margin="0,0,0,10"/>

                                    <TextBlock Text="Vibration Frequency" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <Slider x:Name="SliderRTFreq" Minimum="0" Maximum="255" Value="120" ValueChanged="TriggerMode_Changed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3.5. 6-AXIS GYRO MOTION AIMING VIEW -->
            <Grid x:Name="ViewGyro" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="6-Axis Gyro Motion Aiming" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="High-precision 1000Hz DualSense IMU gyro aiming with sub-pixel ballistics and intelligent ADS activation." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BadgeGyroAiming" Background="#3300E676" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" Visibility="Collapsed">
                                    <TextBlock Text="AIMING ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                </Border>
                                <CheckBox x:Name="ChkEnableGyro" Content="Enable Gyro Aiming" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Checked="Gyro_Changed" Unchecked="Gyro_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Gyro Aiming Setup & Live Meters (2-Column Grid) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Mode & Sensitivity Tuning -->
                            <Border Grid.Column="0" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="MOTION AIMING TUNING" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>

                                    <!-- Activation Mode -->
                                    <TextBlock Text="Activation Condition" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbGyroMode" SelectionChanged="Gyro_Changed" Margin="0,0,0,18">
                                        <ComboBoxItem Content="Hold L2 (Aim Down Sights - ADS)" IsSelected="True"/>
                                        <ComboBoxItem Content="Always On (Continuous Aiming)"/>
                                        <ComboBoxItem Content="Touchpad Touch (Aim while resting thumb)"/>
                                        <ComboBoxItem Content="Hold R2 (Fire Aim)"/>
                                    </ComboBox>

                                    <!-- Sensitivity X -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Yaw Sensitivity (X)" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderGyroSensX" Grid.Column="1" Minimum="0.2" Maximum="4.0" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.2" ValueChanged="Gyro_Changed"/>
                                        <TextBlock x:Name="TxtGyroSensXVal" Grid.Column="2" Text="1.0x" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Sensitivity Y -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Pitch Sensitivity (Y)" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderGyroSensY" Grid.Column="1" Minimum="0.2" Maximum="4.0" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.2" ValueChanged="Gyro_Changed"/>
                                        <TextBlock x:Name="TxtGyroSensYVal" Grid.Column="2" Text="1.0x" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Invert Axes -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <CheckBox x:Name="ChkGyroInvertX" Content="Invert Horizontal (X)" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0" Checked="Gyro_Changed" Unchecked="Gyro_Changed"/>
                                        <CheckBox x:Name="ChkGyroInvertY" Content="Invert Vertical (Y)" Foreground="{DynamicResource TextPrimary}" Checked="Gyro_Changed" Unchecked="Gyro_Changed"/>
                                    </StackPanel>

                                    <!-- Deadzone & Smoothing -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Sensor Deadzone" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderGyroDeadzone" Grid.Column="1" Minimum="0" Maximum="60" Value="20" IsSnapToTickEnabled="True" TickFrequency="2" ValueChanged="Gyro_Changed"/>
                                        <TextBlock x:Name="TxtGyroDeadzoneVal" Grid.Column="2" Text="20" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Motion Smoothing" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderGyroSmooth" Grid.Column="1" Minimum="0.0" Maximum="0.80" Value="0.25" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="Gyro_Changed"/>
                                        <TextBlock x:Name="TxtGyroSmoothVal" Grid.Column="2" Text="25%" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Right: Live IMU Sensor Telemetry -->
                            <Border Grid.Column="1" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LIVE DUALSENSE IMU TELEMETRY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>

                                    <!-- Yaw Progress -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Yaw (Z):" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BarGyroZ" Grid.Column="1" Height="10" Minimum="0" Maximum="500" Value="0" Foreground="{DynamicResource AccentSignature}" Background="#1F283B" BorderThickness="0" Margin="4,0"/>
                                        <TextBlock x:Name="TxtGyroYaw" Grid.Column="2" Text="Yaw: +0000" FontSize="11" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Pitch Progress -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Pitch (X):" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BarGyroX" Grid.Column="1" Height="10" Minimum="0" Maximum="500" Value="0" Foreground="{DynamicResource HeaderAccent}" Background="#1F283B" BorderThickness="0" Margin="4,0"/>
                                        <TextBlock x:Name="TxtGyroPitch" Grid.Column="2" Text="Pitch: +0000" FontSize="11" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Roll Progress -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Roll (Y):" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BarGyroY" Grid.Column="1" Height="10" Minimum="0" Maximum="500" Value="0" Foreground="{StaticResource AccentMagenta}" Background="#1F283B" BorderThickness="0" Margin="4,0"/>
                                        <TextBlock x:Name="TxtGyroRoll" Grid.Column="2" Text="Roll: +0000" FontSize="11" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Calibration info -->
                                    <Border Background="{DynamicResource BgCardHover}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                        <TextBlock Text="• Auto-calibrates resting sensor drift in real time when placed still on flat surfaces.&#x0a;• High-precision sub-pixel mouse translation ensures seamless tracking in competitive shooters." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    </Border>

                                    <Button x:Name="BtnResetGyroDrift" Content="Recalibrate Gyro Baseline" Style="{StaticResource PrimaryBtnStyle}" Background="{DynamicResource HeaderAccent}" HorizontalAlignment="Left" Click="BtnResetGyroDrift_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. TOUCHPAD & MOUSE VIEW -->
            <Grid x:Name="ViewTouchpad" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Touchpad Navigation &amp; Gestures" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Use your controller touchpad as a fluid Windows precision mouse with gestures and tap-to-click." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,24"/>

                        <CheckBox x:Name="ChkMouseEnabled" Content="Enable Touchpad Mouse Cursor Emulation" FontSize="14" FontWeight="SemiBold" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,18" Checked="TouchpadConfig_Changed" Unchecked="TouchpadConfig_Changed"/>

                        <!-- Sensitivity Sliders -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Cursor Movement Sensitivity" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderMouseSens" Grid.Column="1" Minimum="0.2" Maximum="3.0" Value="1.2" ValueChanged="TouchpadConfig_Changed"/>
                            <TextBlock x:Name="TxtMouseSensVal" Grid.Column="2" Text="1.2x" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Two-Finger Scroll Speed" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderScrollSens" Grid.Column="1" Minimum="0.2" Maximum="3.0" Value="1.0" ValueChanged="TouchpadConfig_Changed"/>
                            <TextBlock x:Name="TxtScrollSensVal" Grid.Column="2" Text="1.0x" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="ChkTapClick" FontSize="13" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" Checked="TouchpadConfig_Changed" Unchecked="TouchpadConfig_Changed">
                                <TextBlock Text="Tap-To-Click (Single finger tap = Left Click, Two fingers tap = Right Click)" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="ChkSplitClick" FontSize="13" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" Checked="TouchpadConfig_Changed" Unchecked="TouchpadConfig_Changed">
                                <TextBlock Text="Split Physical Click (Right 25% zone triggers Right Click)" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="ChkInvertY" Content="Invert Y Axis Movement" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="TouchpadConfig_Changed" Unchecked="TouchpadConfig_Changed"/>
                        </StackPanel>

                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
                            <TextBlock Text="Shortcut: Hold PS Button + D-Pad Up/Down to adjust sensitivity on the fly without opening the app." FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. AUDIO & MIC MUTE VIEW -->
            <Grid x:Name="ViewAudio" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Audio DAC &amp; Hardware Mute Integration" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Hardware communication with controller DAC, 3.5mm headphone jack, microphone, and mute button." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,24"/>

                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="HARDWARE MIC MUTE BUTTON SYNCHRONIZATION" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}" Margin="0,0,0,8"/>
                                <TextBlock Text="Syncs the DualSense physical microphone mute button directly with Windows CoreAudio. Pressing the button on the controller mutes Windows microphone and illuminates the amber hardware LED in real time." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>

                                <CheckBox x:Name="ChkSyncMic" FontSize="14" FontWeight="SemiBold" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Checked="MicSync_Changed" Unchecked="MicSync_Changed">
                                    <TextBlock Text="Synchronize Controller Mic Button with Windows System Microphone" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Audio-Reactive Haptic Bass Rumble Card -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="AUDIO-REACTIVE HAPTIC BASS RUMBLE (WASAPI LOOPBACK)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}"/>
                                        <TextBlock Text="Captures Windows system and game audio in real time, isolates low-frequency explosions, footsteps, engine revs, and gunshots, and routes them directly to the controller's voice-coil haptic motors." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAudioHaptics" Grid.Column="1" Content="Enable Haptics" FontSize="13" FontWeight="Bold" IsChecked="True" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Checked="AudioHaptics_Changed" Unchecked="AudioHaptics_Changed"/>
                                </Grid>

                                <!-- Haptic Intensity Slider -->
                                <Grid Margin="0,12,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vibration Intensity" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderHapticIntensity" Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1" ValueChanged="AudioHaptics_Changed"/>
                                    <TextBlock x:Name="TxtHapticIntensityVal" Grid.Column="2" Text="100%" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Low-Pass Bass Cutoff Slider (4th-Order 24dB/oct Surgical Filter) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Bass Cutoff Filter" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderHapticCutoff" Grid.Column="1" Minimum="40" Maximum="250" Value="100" IsSnapToTickEnabled="True" TickFrequency="10" SmallChange="10" LargeChange="20" ValueChanged="AudioHaptics_Changed"/>
                                    <TextBlock x:Name="TxtHapticCutoffVal" Grid.Column="2" Text="100 Hz (Punchy)" FontSize="12" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Audio-to-Trigger Mechanical Recoil Kick -->
                                <Border Background="{DynamicResource BgCardHover}" CornerRadius="8" Padding="14,12" Margin="0,4,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Audio-to-Trigger Mechanical Recoil Kick" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Pulses DualSense adaptive trigger stepper motors during heavy bass transients (gunshots, explosions) for realistic weapon recoil." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkTriggerKick" Grid.Column="1" Content="Enable Kick" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Checked="AudioHaptics_Changed" Unchecked="AudioHaptics_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Recoil Transient Sensitivity" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderTriggerThreshold" Grid.Column="1" Minimum="0.15" Maximum="0.85" Value="0.45" IsSnapToTickEnabled="True" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1" ValueChanged="AudioHaptics_Changed"/>
                                            <TextBlock x:Name="TxtTriggerThresholdVal" Grid.Column="2" Text="45%" FontSize="12" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Stereo Mode & Live Tactile Meters -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,6">
                                        <RadioButton x:Name="RadioHapticStereo" Content="Directional Stereo (L / R)" GroupName="HapticMode" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Checked="AudioHaptics_Changed" Margin="0,0,0,4"/>
                                        <RadioButton x:Name="RadioHapticMono" Content="Combined Mono" GroupName="HapticMode" Foreground="{DynamicResource TextPrimary}" Checked="AudioHaptics_Changed"/>
                                    </StackPanel>

                                    <!-- Live Tactile Meters (Left & Right) -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8" MinWidth="200" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Grip -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left Grip:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <ProgressBar x:Name="BarHapticL" Grid.Row="0" Grid.Column="1" Height="10" Minimum="0" Maximum="255" Value="0" Foreground="{DynamicResource AccentSignature}" Background="#1F283B" BorderThickness="0" Margin="4,3"/>
                                            <TextBlock x:Name="TxtHapticL" Grid.Row="0" Grid.Column="2" Text="0" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Right Grip -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Right Grip:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <ProgressBar x:Name="BarHapticR" Grid.Row="1" Grid.Column="1" Height="10" Minimum="0" Maximum="255" Value="0" Foreground="{DynamicResource HeaderAccent}" Background="#1F283B" BorderThickness="0" Margin="4,3"/>
                                            <TextBlock x:Name="TxtHapticR" Grid.Row="1" Grid.Column="2" Text="0" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="DETECTED AUDIO ENDPOINTS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Playback Device:" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtRenderDev" Grid.Column="1" Text="Speakers (DualSense Wireless Controller)" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Microphone Device:" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtCaptureDev" Grid.Column="1" Text="Headset Microphone (DualSense Wireless Controller)" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5.5. GAME PROFILES & PRESETS VIEW -->
            <Grid x:Name="ViewProfiles" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Game-Specific Profiles &amp; Preset Library" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Seamless automatic switching when games enter foreground, plus community sharing and tuned presets." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoSwitchProfile" Grid.Column="1" Content="Auto-Switch per Game" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" IsChecked="True" Checked="ChkAutoSwitchProfile_Changed" Unchecked="ChkAutoSwitchProfile_Changed"/>
                        </Grid>

                        <!-- Profile Selection Bar -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Select Profile: " FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CmbProfiles" MinWidth="260" SelectionChanged="CmbProfiles_SelectionChanged"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Apply Profile" Style="{StaticResource PrimaryBtnStyle}" Background="{StaticResource AccentGreen}" Margin="0,0,8,4" Click="BtnApplyProfile_Click"/>
                                    <Button Content="Save Current" Style="{StaticResource PrimaryBtnStyle}" Background="{DynamicResource HeaderAccent}" Margin="0,0,8,4" Click="BtnSaveProfile_Click"/>
                                    <Button Content="Duplicate" Style="{StaticResource PrimaryBtnStyle}" Background="#243046" Margin="0,0,8,4" Click="BtnDuplicateProfile_Click"/>
                                    <Button Content="Export (.json)" Style="{StaticResource PrimaryBtnStyle}" Background="#243046" Margin="0,0,8,4" Click="BtnExportProfile_Click"/>
                                    <Button Content="Import" Style="{StaticResource PrimaryBtnStyle}" Background="#243046" Margin="0,0,8,4" Click="BtnImportProfile_Click"/>
                                    <Button x:Name="BtnDeleteProfile" Content="Delete" Style="{StaticResource PrimaryBtnStyle}" Background="{StaticResource AccentRed}" Margin="0,0,0,4" Click="BtnDeleteProfile_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Profile Configuration Details -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ACTIVE PROFILE DETAILS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Profile Name:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtProfileName" Grid.Column="1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="8,5"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Description:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtProfileDesc" Grid.Column="1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="8,5"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Game Executables:" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="(Comma-separated .exe)" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtProfileProcesses" Grid.Column="1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="8,5"/>
                                </Grid>

                                <!-- Config Summary Matrix -->
                                <Border Background="{DynamicResource BgCardHover}" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Adaptive Triggers" FontWeight="Bold" Foreground="{DynamicResource AccentSignature}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtSummaryTriggers" Text="L2: TriggerStop (Hair) • R2: TriggerStop (Hair)" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Lightbar &amp; Audio Haptics" FontWeight="Bold" Foreground="{DynamicResource HeaderAccent}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtSummaryHaptics" Text="RGB: #00D2FF • Haptics: 120% Stereo • Recoil Kick On" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="6-Axis Gyro &amp; Touchpad" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtSummaryGyro" Text="Gyro: Enabled (ADS L2 Hold) • Touchpad Mouse: On" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 6. DRIVER & BUS SETUP VIEW -->
            <Grid x:Name="ViewDriver" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Driver &amp; Virtual Bus Management" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Manage the low-latency OpenDualDriver background engine and Xbox 360 compatibility bus." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,24"/>

                        <!-- Virtual Bus Card -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ViGEmBus Virtual Gamepad Bus" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Allows games on Windows 10 &amp; 11 to see an Xbox 360 controller with zero lag." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Status: " Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtViGEmStatus" Text="Checking..." FontWeight="Bold" Foreground="{DynamicResource AccentSignature}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="BtnInstallViGEm" Grid.Column="1" Content="Install ViGEmBus Driver" Style="{StaticResource PrimaryBtnStyle}" Click="BtnInstallViGEm_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Driver Core Engine Card -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="OpenDualDriver Service (1000Hz C++20 Direct HID)" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Asynchronous overlapped Direct HID reader with sub-millisecond dispatch." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Service Status: " Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtEngineStatus" Text="Running (1000Hz Active)" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="BtnStartEngine" Content="Start Engine" Style="{StaticResource PrimaryBtnStyle}" Background="{StaticResource AccentGreen}" Margin="0,0,8,4" Click="BtnStartEngine_Click"/>
                                    <Button x:Name="BtnRestartEngine" Content="Restart Engine" Style="{StaticResource PrimaryBtnStyle}" Background="{DynamicResource HeaderAccent}" Margin="0,0,8,4" Click="BtnRestartEngine_Click"/>
                                    <Button x:Name="BtnStopEngine" Content="Stop Engine" Style="{StaticResource PrimaryBtnStyle}" Background="{StaticResource AccentRed}" Margin="0,0,0,4" Click="BtnStopEngine_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Quick HUD and System Tray Preferences -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Quick HUD &amp; Background Tray Preferences" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Seamless in-game overlay and lightweight background system tray residency." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16"/>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="In-Game PS Button Quick HUD Overlay" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Displays a sleek PS5-style floating status card (battery %, volume, mic mute, triggers) whenever you press the PS button." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Preview HUD" Style="{StaticResource PrimaryBtnStyle}" Background="#222B3F" Padding="12,6" Margin="0,0,12,0" Click="BtnPreviewQuickHud_Click"/>
                                        <CheckBox x:Name="ChkEnableQuickHud" Content="Enabled" FontWeight="SemiBold" IsChecked="True" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="HUD Display Scale &amp; Size" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Scale the Control Center overlay for high-DPI monitors, ultra-wide setups, or couch/TV gaming." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbHudScale" Grid.Column="1" Width="180" SelectionChanged="CmbHudScale_SelectionChanged">
                                        <ComboBoxItem Content="Compact (85%)" Tag="0.85"/>
                                        <ComboBoxItem Content="Standard (100% - Default)" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="Large (115%)" Tag="1.15"/>
                                        <ComboBoxItem Content="Couch / 4K TV (130%)" Tag="1.30"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Minimize to Windows System Tray" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Hides the application window from the taskbar and docks an icon in the notification area." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" Content="Enabled" FontWeight="SemiBold" IsChecked="True" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Power Management & Battery Preferences -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Bluetooth Power Management &amp; Battery Health" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Automate low-power standby during controller inactivity and preserve battery life." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Inactivity Sleep Standby Timer" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Automatically powers down LEDs and motor loopbacks after periods of zero user movement." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbIdleTimeout" Grid.Column="1" Width="180" SelectionChanged="PowerSettings_Changed">
                                        <ComboBoxItem Content="Disabled (Never Sleep)"/>
                                        <ComboBoxItem Content="5 Minutes"/>
                                        <ComboBoxItem Content="10 Minutes (Default)" IsSelected="True"/>
                                        <ComboBoxItem Content="15 Minutes"/>
                                        <ComboBoxItem Content="30 Minutes"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Critical Low-Battery Lightbar Pulse Alert" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Flashes the DualSense lightbar with a gentle red pulse when battery level falls below 15%." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkLowBatteryWarn" Grid.Column="1" Content="Enabled" FontWeight="SemiBold" IsChecked="True" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Checked="PowerSettings_Changed" Unchecked="PowerSettings_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- In-App Automatic Updater -->
                        <Border Background="{DynamicResource SlotBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="In-App Automatic Suite Updater" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Check and seamlessly install updates directly from the official GitHub releases repository." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Installed Version: " Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="v1.5.0 (Latest Release)" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtUpdateStatus" Text="Up to date." FontSize="11" Foreground="{DynamicResource AccentSignature}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCheckUpdates" Grid.Column="1" Content="Check for Updates" Style="{StaticResource PrimaryBtnStyle}" Background="{DynamicResource HeaderAccent}" Click="BtnCheckUpdates_Click"/>
                                </Grid>

                                <!-- Available Update Card -->
                                <Border x:Name="PanelUpdateAvailable" Background="{DynamicResource BgCardHover}" CornerRadius="8" Padding="14,12" Margin="0,6,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtNewVersionTitle" Text="New Update Available: v1.4.x" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentGreen}"/>
                                        <TextBlock x:Name="TxtNewVersionNotes" Text="Release highlights..." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="ProgressUpdate" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1F283B" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Margin="0,0,0,10" Visibility="Collapsed"/>
                                        <Button x:Name="BtnInstallUpdate" Content="Download &amp; Install Update (Relaunch)" Style="{StaticResource PrimaryBtnStyle}" Background="{StaticResource AccentGreen}" HorizontalAlignment="Left" Click="BtnInstallUpdate_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtDriverLog" Text="" Foreground="{DynamicResource AccentSignature}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            </Grid>
        </ScrollViewer>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="FooterStatus" Text="Ready" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource BorderColor}"/>
                    <TextBlock x:Name="FooterEngineStatus" Text="Engine: Active (1000Hz)" FontSize="11" Foreground="{StaticResource AccentGreen}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="OpenDual Suite v1.5.0" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
