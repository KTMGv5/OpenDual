<UserControl x:Class="OpenDualHub.XmbCategoryInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenDualHub"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="680">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2979FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF334B"/>
        <SolidColorBrush x:Key="AccentMagenta" Color="#FF007F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AACC4"/>
        <SolidColorBrush x:Key="BgCard" Color="#CC0E1422"/>
        <SolidColorBrush x:Key="SlotBg" Color="#B0080C14"/>
        <SolidColorBrush x:Key="PillBg" Color="#1F283B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#352979FF"/>

        <Style x:Key="XmbOptionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="#1C2740"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="XmbToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="#1C2740"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="{StaticResource AccentSignature}"/>
                                <Setter Property="Foreground" Value="#080B13"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#00F5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="CategoryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:SmoothScrollHelper.SmoothScroll="True">
        <StackPanel Margin="6">

            <!-- DYNAMIC ITEM FOCUS BREADCRUMB BANNER -->
            <Border x:Name="BannerItemFocus" Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBannerCategory" Text="🎮 CONTROLLER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="  ›  " FontSize="11" Foreground="{StaticResource AccentSignature}"/>
                            <TextBlock x:Name="TxtBannerItem" Text="Controller Overview" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBannerSubtitle" Text="Interactive hardware inspection &amp; realtime telemetry" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                        <TextBlock x:Name="TxtBannerBadge" Text="Active" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 1. TRIGGERS PANEL -->
            <StackPanel x:Name="PanelTriggers" Visibility="Collapsed">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="⚡ ADAPTIVE TRIGGER ENGINE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure force-feedback resistance profiles for L2 and R2 motor worm gears." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>

                        <!-- Left Trigger (L2) -->
                        <Border x:Name="CardTrigL2" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="LEFT TRIGGER (L2 - AIM / BRAKE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtL2ModeBadge" Text="Rigid Section Snap" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="BtnL2_0" Content="Off (Linear)" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnL2Mode_Click" Tag="0"/>
                                    <Button x:Name="BtnL2_1" Content="Game Specific SDK" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnL2Mode_Click" Tag="1"/>
                                    <Button x:Name="BtnL2_2" Content="Rigid Section Snap" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentSignature}" Foreground="#080B13" Margin="0,0,6,6" Click="BtnL2Mode_Click" Tag="2"/>
                                    <Button x:Name="BtnL2_3" Content="Compound Bow" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnL2Mode_Click" Tag="3"/>
                                    <Button x:Name="BtnL2_4" Content="Machine Gun Recoil" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnL2Mode_Click" Tag="4"/>
                                </WrapPanel>
                                <ProgressBar x:Name="BarL2Inspector" Height="6" Minimum="0" Maximum="100" Value="0" Background="#141B2B" Foreground="{StaticResource AccentSignature}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Trigger (R2) -->
                        <Border x:Name="CardTrigR2" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="RIGHT TRIGGER (R2 - FIRE / THROTTLE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtR2ModeBadge" Text="Game Specific SDK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="BtnR2_0" Content="Off (Linear)" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnR2Mode_Click" Tag="0"/>
                                    <Button x:Name="BtnR2_1" Content="Game Specific SDK" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentSignature}" Foreground="#080B13" Margin="0,0,6,6" Click="BtnR2Mode_Click" Tag="1"/>
                                    <Button x:Name="BtnR2_2" Content="Rigid Section Snap" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnR2Mode_Click" Tag="2"/>
                                    <Button x:Name="BtnR2_3" Content="Compound Bow" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnR2Mode_Click" Tag="3"/>
                                    <Button x:Name="BtnR2_4" Content="Machine Gun Recoil" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnR2Mode_Click" Tag="4"/>
                                </WrapPanel>
                                <ProgressBar x:Name="BarR2Inspector" Height="6" Minimum="0" Maximum="100" Value="0" Background="#141B2B" Foreground="{StaticResource AccentSignature}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Oscilloscope & Snap Tension -->
                        <Border x:Name="CardTrigSnap" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="CLICK-SNAP BARRIER TENSION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtSnapTensionVal" Text="85% Force" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderSnapTension" Minimum="10" Maximum="100" Value="85" Margin="0,0,0,8" ValueChanged="SliderSnapTension_ValueChanged"/>

                                <TextBlock Text="FORCE RESISTANCE &amp; TORQUE OSCILLOSCOPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,4,0,4"/>
                                <Canvas x:Name="CanvasTrigOscilloscope" Height="64" Background="#0C101A" ClipToBounds="True" Margin="0,0,0,6"/>
                                <TextBlock Text="Real-time torque curves: Cyan = L2 Aim Wall, Magenta = R2 Trigger Recoil. Values reflect live motor resistance." FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. GYRO AIM PANEL -->
            <StackPanel x:Name="PanelGyro" Visibility="Collapsed">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <Border x:Name="CardGyroEnable" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🎯 6-AXIS GYROSCOPE AIMING" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                                    <TextBlock Text="Natural motion crosshair assistance with high-rate 1000Hz IMU fusion." FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleGyroEnable" Content="Gyro Aim: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleGyroEnable_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardGyroOutput" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="OUTPUT EMULATION MODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnGyroMouse" Content="🖱️ Windows Mouse Emulation" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentSignature}" Foreground="#080B13" Margin="0,0,8,0" Click="BtnGyroMode_Click" Tag="0"/>
                                    <Button x:Name="BtnGyroStick" Content="🕹️ XInput Right Thumbstick" Style="{StaticResource XmbOptionBtn}" Click="BtnGyroMode_Click" Tag="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardGyroTriggerMode" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ACTIVATION TRIGGER MODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnGyroTrigADS" Content="Hold L2 (ADS)" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentSignature}" Foreground="#080B13" Margin="0,0,6,6" Click="BtnGyroTriggerMode_Click" Tag="1"/>
                                    <Button x:Name="BtnGyroTrigAlways" Content="Always Active" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnGyroTriggerMode_Click" Tag="0"/>
                                    <Button x:Name="BtnGyroTrigTouch" Content="Touchpad Touch" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnGyroTriggerMode_Click" Tag="2"/>
                                    <Button x:Name="BtnGyroTrigR2" Content="Hold R2" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnGyroTriggerMode_Click" Tag="3"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardGyroTuning" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="HORIZONTAL SENSITIVITY (X)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtSensXVal" Text="1.20x" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderSensX" Minimum="0.2" Maximum="3.0" Value="1.2" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="SliderSens_ValueChanged"/>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="VERTICAL SENSITIVITY (Y - PITCH)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtSensYVal" Text="1.20x" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderSensY" Minimum="0.2" Maximum="3.0" Value="1.2" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="SliderSens_ValueChanged"/>

                                <Grid Margin="0,0,0,6">
                                    <CheckBox x:Name="ChkGyroInvertY" Content="Invert Vertical Aim (Y-Axis)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Click="ChkGyroInvert_Click"/>
                                    <CheckBox x:Name="ChkGyroInvertX" Content="Invert Horizontal Aim (X-Axis)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" Click="ChkGyroInvert_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="SENSOR DEADZONE (DEG/S)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtDeadzoneVal" Text="3 deg/s" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderDeadzone" Minimum="0" Maximum="10" Value="3" Margin="0,0,0,10" ValueChanged="SliderDeadzone_ValueChanged"/>

                                <TextBlock Text="LIVE MOTION RETICLE (IMU RESPONSE)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,4,0,4"/>
                                <Canvas x:Name="CanvasGyroMotion" Height="70" Background="#0C101A" ClipToBounds="True"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnLaunchCalibrator" Content="🪄 Launch Interactive Gyro Calibrator Wizard" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentBlue}" Padding="16,10" HorizontalAlignment="Left" Click="BtnLaunchCalibrator_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. LIGHTBAR PANEL -->
            <StackPanel x:Name="PanelLightbar" Visibility="Collapsed">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🌈 DUALSENSE RGB LIGHTBAR" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                        <TextBlock Text="Customize LED illumination effects, glow colors, and player indicator LEDs." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <Border x:Name="CardLedEffect" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="LIGHTBAR ANIMATION MODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnLedEff0" Content="Solid Color" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnLedEffect_Click" Tag="0"/>
                                    <Button x:Name="BtnLedEff1" Content="Breathing Pulse" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnLedEffect_Click" Tag="1"/>
                                    <Button x:Name="BtnLedEff2" Content="Rainbow Wave" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentSignature}" Foreground="#080B13" Margin="0,0,6,6" Click="BtnLedEffect_Click" Tag="2"/>
                                    <Button x:Name="BtnLedEff3" Content="Audio Reactive" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnLedEffect_Click" Tag="3"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardLedColor" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="QUICK COLOR PRESETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <Border x:Name="ColorPreviewPill" Background="#00F5D4" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtHexCode" Text="#00F5D4" FontSize="10" FontWeight="Bold" Foreground="#080B13"/>
                                    </Border>
                                </Grid>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Signature Cyan" Style="{StaticResource XmbOptionBtn}" Background="#00F5D4" Foreground="#080B13" Margin="0,0,6,6" Click="BtnColorPreset_Click" Tag="#00F5D4"/>
                                    <Button Content="Classic Blue" Style="{StaticResource XmbOptionBtn}" Background="#2979FF" Margin="0,0,6,6" Click="BtnColorPreset_Click" Tag="#2979FF"/>
                                    <Button Content="Neon Magenta" Style="{StaticResource XmbOptionBtn}" Background="#FF007F" Margin="0,0,6,6" Click="BtnColorPreset_Click" Tag="#FF007F"/>
                                    <Button Content="Emerald Green" Style="{StaticResource XmbOptionBtn}" Background="#00E676" Foreground="#080B13" Margin="0,0,6,6" Click="BtnColorPreset_Click" Tag="#00E676"/>
                                    <Button Content="Solar Amber" Style="{StaticResource XmbOptionBtn}" Background="#FFA000" Foreground="#080B13" Margin="0,0,6,6" Click="BtnColorPreset_Click" Tag="#FFA000"/>
                                    <Button Content="Crimson Red" Style="{StaticResource XmbOptionBtn}" Background="#FF334B" Margin="0,0,6,6" Click="BtnColorPreset_Click" Tag="#FF334B"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Player LED Indicators -->
                        <Border x:Name="CardLedPlayers" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PLAYER LED INDICATORS (UNDER TOUCHPAD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnPled1" Content="Player 1 (Center)" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentSignature}" Foreground="#080B13" Margin="0,0,6,6" Click="BtnPlayerLed_Click" Tag="4"/>
                                    <Button x:Name="BtnPled2" Content="Player 2 (2 LEDs)" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnPlayerLed_Click" Tag="10"/>
                                    <Button x:Name="BtnPled3" Content="Player 3 (3 LEDs)" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnPlayerLed_Click" Tag="21"/>
                                    <Button x:Name="BtnPled4" Content="Player 4 (4 LEDs)" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnPlayerLed_Click" Tag="27"/>
                                    <Button x:Name="BtnPledAll" Content="All 5 LEDs" Style="{StaticResource XmbOptionBtn}" Margin="0,0,6,6" Click="BtnPlayerLed_Click" Tag="31"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardLedBrightness" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="LIGHTBAR BRIGHTNESS LEVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtBrightnessVal" Text="100%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderBrightness" Minimum="10" Maximum="100" Value="100" ValueChanged="SliderBrightness_ValueChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. TOUCHPAD & GESTURES PANEL -->
            <StackPanel x:Name="PanelTouchpad" Visibility="Collapsed">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🖱️ CAPACITIVE TOUCHPAD &amp; CUSTOM GESTURES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                        <TextBlock Text="Multi-touch surface navigation, discrete scrolling, and programmable gesture shortcuts." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <!-- Touchpad Mouse -->
                        <Border x:Name="CardTouchMouse" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TOUCHPAD PRECISION MOUSE EMULATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Capacitive desktop cursor navigation" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ToggleTouchMouse" Content="Mouse: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleTouchMouse_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="TRACKPAD SENSITIVITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtTouchSensVal" Text="1.20x" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderTouchSens" Minimum="0.2" Maximum="3.0" Value="1.2" Margin="0,0,0,6" ValueChanged="SliderTouchSens_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Discrete Notched Scroll Mode -->
                        <Border x:Name="CardTouchNotch" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISCRETE NOTCHED SCROLL (INVENTORY SAFE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="One slot per swipe: safe for Minecraft hotbars, weapon wheels &amp; menus" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleDiscreteScroll" Content="Notched: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleDiscreteScroll_Click"/>
                            </Grid>
                        </Border>

                        <!-- Right-Edge Volume Slider Gesture (Default OFF) -->
                        <Border x:Name="CardTouchVol" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="RIGHT-EDGE VOLUME SLIDER GESTURE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Slide vertically along right edge to adjust Master Volume (Default: Off)" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleTouchVol" Content="Gesture: OFF" Style="{StaticResource XmbToggle}" IsChecked="False" HorizontalAlignment="Right" Click="ToggleTouchVol_Click"/>
                            </Grid>
                        </Border>

                        <!-- Tap-to-Click -->
                        <Border x:Name="CardTouchTap" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TAP-TO-CLICK &amp; MULTI-TOUCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Tap surface to click without depressing the physical button" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleTouchTap" Content="Tap: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleTouchTap_Click"/>
                            </Grid>
                        </Border>

                        <!-- Custom Gesture Shortcuts Engine -->
                        <Border x:Name="CardTouchGestures" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1.5" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="✍️ PROGRAMMABLE UNISTROKE GESTURES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                                        <TextBlock Text="Draw shapes or letters on the touchpad to trigger customizable Windows actions" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ToggleGestures" Content="Gestures: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleGestures_Click"/>
                                </Grid>

                                <!-- Interactive Sandbox Canvas -->
                                <Border Background="#0C101A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Canvas x:Name="CanvasGestureSandbox" Height="90" ClipToBounds="True"/>
                                        <TextBlock x:Name="TxtGestureFeedback" Text="Draw on touchpad: 'C' (Screenshot), 'V' (Clip), 'S' (HUD), 'O' (Hub), or Swipes" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Gesture Mappings Summary -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="• Draw 'C'  ›  Screenshot (Win+Shift+S)" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                        <TextBlock Text="• Draw 'V'  ›  30s Replay Clip (Win+Alt+G)" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                        <TextBlock Text="• Draw 'S'  ›  Open PS Quick HUD" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                        <TextBlock Text="• Draw 'O'  ›  Open OpenDual Hub" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="• Swipe Left  ›  Previous Music Track" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                        <TextBlock Text="• Swipe Right ›  Next Music Track" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                        <TextBlock Text="• Swipe Up    ›  Play / Pause Media" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                        <TextBlock Text="• Swipe Down  ›  Mute / Unmute Mic" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 5. AUDIO & HAPTICS PANEL -->
            <StackPanel x:Name="PanelAudio" Visibility="Collapsed">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🔊 AUDIO &amp; DUALSENSE VOICE-COIL HAPTICS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                        <TextBlock Text="Haptic tactile motors, sub-bass recoil, and controller speaker output." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <Border x:Name="CardAudHaptic" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DUALSENSE VOICE-COIL HAPTICS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Wideband voice-coil haptic actuators in palm grips" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleHaptics" Content="Haptics: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleHaptics_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardAudReactive" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="AUDIO-TO-HAPTICS RECOIL INTENSITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtHapticIntensity" Text="30% (Recommended)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderHapticIntensity" Minimum="0" Maximum="100" Value="30" Margin="0,0,0,4" ValueChanged="SliderHapticIntensity_ValueChanged"/>
                                <TextBlock Text="Default 30% intensity and 40Hz bass cutoff provides smooth tactile rumble." FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardAudSpeaker" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CONTROLLER SPEAKER OUTPUT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Route audio directly to controller built-in DAC speaker (Default: Off)" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleSpeaker" Content="Speaker: OFF" Style="{StaticResource XmbToggle}" IsChecked="False" HorizontalAlignment="Right" Click="ToggleSpeaker_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardAudMic" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MICROPHONE MUTE SYNCHRONIZATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Sync controller mute button and amber LED with Windows system microphone" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleMicSync" Content="Mic Sync: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleMicSync_Click"/>
                            </Grid>
                        </Border>

                        <!-- Volume Overlay HUD Notification (Default: OFF per user request) -->
                        <Border x:Name="CardAudVolumeHud" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ON-SCREEN VOLUME HUD POP-UP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Show pop-up volume bar when changing volume with controller (Default: Off)" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleVolumeOverlay" Content="Overlay: OFF" Style="{StaticResource XmbToggle}" IsChecked="False" HorizontalAlignment="Right" Click="ToggleVolumeOverlay_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 6. PROFILES PANEL -->
            <StackPanel x:Name="PanelProfiles" Visibility="Collapsed">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="👤 PROFILES &amp; PRESETS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                        <TextBlock Text="Switch between tailored profiles or link profiles to game executables." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <Border x:Name="CardProfDefault" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🎮 Standard Balanced" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Standard haptics, rigid section trigger snap, and signature cyan lightbar" FontSize="11" Foreground="{StaticResource AccentSignature}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnActDefault" Content="Activate" Style="{StaticResource XmbOptionBtn}" HorizontalAlignment="Right" Click="BtnActivateProfile_Click" Tag="Standard Balanced"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardProfEsports" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🏆 Esports Ultra 1000Hz" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="1000Hz polling rate, Hall-stabilizer filtering, hair triggers &amp; zero drift" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnActEsports" Content="Activate" Style="{StaticResource XmbOptionBtn}" HorizontalAlignment="Right" Click="BtnActivateProfile_Click" Tag="Esports Ultra 1000Hz"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardProfFps" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🎯 FPS Gyro Specialist" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Motion aim down sights (L2 ADS) with spatial footstep radar audio" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnActFps" Content="Activate" Style="{StaticResource XmbOptionBtn}" HorizontalAlignment="Right" Click="BtnActivateProfile_Click" Tag="FPS Gyro Specialist"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardProfRacing" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🏎️ Racing Force Feedback" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Progressive brake wall tension &amp; dynamic throttle engine vibration" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnActRacing" Content="Activate" Style="{StaticResource XmbOptionBtn}" HorizontalAlignment="Right" Click="BtnActivateProfile_Click" Tag="Racing Force Feedback"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 7. SETTINGS & SYSTEM PANEL -->
            <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚙️ SYSTEM &amp; DRIVER ENGINE SETTINGS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                        <TextBlock Text="Direct Win32 kernel HID service configuration, auto-start, and automatic software updates." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <Border x:Name="CardSetDriver" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DIRECT HID SERVICE (OpenDualDriver.exe)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="High-priority Win32 overlapped 1000Hz kernel polling engine" FontSize="10" Foreground="{StaticResource AccentGreen}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Content="Restart Service" Style="{StaticResource XmbOptionBtn}" HorizontalAlignment="Right" Click="BtnRestartDriver_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardSetAutoStart" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LAUNCH ON WINDOWS STARTUP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Start minimized in system tray on Windows user login" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleAutoStart" Content="Auto-Start: ON" Style="{StaticResource XmbToggle}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleAutoStart_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CardSetIdle" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BATTERY IDLE SLEEP TIMER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Automatically power off wireless controller after inactivity" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbIdleTimeout" Width="120" HorizontalAlignment="Right" SelectedIndex="1" SelectionChanged="CmbIdleTimeout_SelectionChanged">
                                    <ComboBoxItem Content="5 Minutes"/>
                                    <ComboBoxItem Content="10 Minutes"/>
                                    <ComboBoxItem Content="15 Minutes"/>
                                    <ComboBoxItem Content="Never"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Interactive In-App Software Updater Card -->
                        <Border x:Name="CardSetUpdate" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SOFTWARE RELEASE VERSION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtXmbUpdateStatus" Text="OpenDual Suite v1.6.6 (Click Check for Updates to query GitHub releases)" FontSize="10" Foreground="{StaticResource AccentSignature}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCheckUpdates" Content="Check for Updates" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentBlue}" HorizontalAlignment="Right" Click="BtnCheckUpdates_Click"/>
                                </Grid>

                                <!-- Hidden unless update found -->
                                <Border x:Name="PanelXmbUpdateDetails" Background="#2000F5D4" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtXmbNewVersionTitle" Text="New Update Available!" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                        <TextBlock x:Name="TxtXmbNewVersionNotes" Text="Includes performance enhancements and fixes." FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,6"/>
                                        <ProgressBar x:Name="ProgressXmbUpdate" Height="6" Minimum="0" Maximum="100" Value="0" Background="#141B2B" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,6"/>
                                        <Button x:Name="BtnXmbInstallUpdate" Content="📥 Download &amp; Install Now" Style="{StaticResource XmbOptionBtn}" Background="{StaticResource AccentGreen}" Foreground="#080B13" HorizontalAlignment="Left" Click="BtnXmbInstallUpdate_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
