<UserControl x:Class="OpenDualHub.NovelFeaturesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenDualHub"
             mc:Ignorable="d" 
             d:DesignHeight="1600" d:DesignWidth="680">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2979FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF334B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AACC4"/>
        <SolidColorBrush x:Key="BgCard" Color="#CC0E1422"/>
        <SolidColorBrush x:Key="SlotBg" Color="#B0080C14"/>
        <SolidColorBrush x:Key="BorderColor" Color="#352979FF"/>

        <Style x:Key="NovelToggleBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="#1C2740"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource AccentSignature}"/>
                                <Setter Property="Foreground" Value="#080B13"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00F5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="NovelScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:SmoothScrollHelper.SmoothScroll="True">
        <StackPanel Margin="6">

            <!-- HEADER BANNER -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="PRO RESPONSE &amp; SENSOR TUNING" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="#2600F5D4" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="KERNEL ENGINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Low-latency actuation, motion stabilization, and hardware protection running natively at 1000Hz." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <TextBlock Text="PRO SUITE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- FEATURE 1: ESPORTS BATTERY LONGEVITY SENTINEL -->
            <Border x:Name="CardSentinel" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔋" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="ESPORTS BATTERY LONGEVITY SENTINEL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleBatteryGuard" Content="80% Battery Guard: ON" Style="{StaticResource NovelToggleBtn}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleBatteryGuard_Click"/>
                    </Grid>

                    <TextBlock Text="Playing wired at 1000Hz keeps lithium battery pinned at 100% full voltage, degrading battery cells rapidly. The 80% Sentinel prevents cell degradation and thermal swelling." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="BATTERY HEALTH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtBatteryHealth" Text="98.4% (Pro)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="1,560 / 1,560 mAh" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CELL VOLTAGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtCellVoltage" Text="3.86 V" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="Safe Storage Range" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="WORM-GEAR MOTOR TEMP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtThermalTemp" Text="26.5°C" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtThermalSub" Text="Cool &amp; Optimal" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FEATURE 2: DIRECTIONAL SPATIAL AUDIO HAPTIC RADAR -->
            <Border x:Name="CardRadar" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎧" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="DIRECTIONAL SPATIAL AUDIO HAPTIC RADAR" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleSpatialRadar" Content="Spatial Radar: ON" Style="{StaticResource NovelToggleBtn}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleSpatialRadar_Click"/>
                    </Grid>

                    <TextBlock Text="Filters in-game footsteps and reloads (50Hz - 160Hz) and converts stereo audio panning into physical directional tactile pulses on the left vs right voice coils." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="120" Height="120" Background="#0C101A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left">
                            <Canvas x:Name="CanvasSpatialRadar" Width="120" Height="120" ClipToBounds="True"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="LEFT PALM TACTILE (L GRIP)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="TxtTactileLeftPct" Text="50% Pulse" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="BarTactileLeft" Height="7" Minimum="0" Maximum="100" Value="50" Background="#141B2B" Foreground="{StaticResource AccentSignature}" BorderThickness="0" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="RIGHT PALM TACTILE (R GRIP)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="TxtTactileRightPct" Text="50% Pulse" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="BarTactileRight" Height="7" Minimum="0" Maximum="100" Value="50" Background="#141B2B" Foreground="{StaticResource AccentBlue}" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FEATURE 3: VIRTUAL HALL-EFFECT ANTI-JITTER THUMBSTICK STABILIZER -->
            <Border x:Name="CardHall" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧠" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="VIRTUAL HALL-EFFECT ANTI-JITTER STABILIZER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleHallFilter" Content="Hall Stabilizer: ON" Style="{StaticResource NovelToggleBtn}" IsChecked="True" HorizontalAlignment="Right" Click="ToggleHallFilter_Click"/>
                    </Grid>

                    <TextBlock Text="Carbon-film potentiometers naturally output microscopic voltage jitter at 1000Hz. This real-time hysteresis filter purifies the signal to 100% Hall-Effect purity with 0ms lag." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Border Height="70" Background="#0C101A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Canvas x:Name="CanvasHallOscilloscope" Height="70" ClipToBounds="True"/>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SIGNAL STABILITY" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtHallPurity" Text="100% Hall Purity (0.000 Jitter)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="FILTER DELAY" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                            <TextBlock Text="0.00 ms (Zero Added Lag)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PRO RESPONSE & SENSOR TUNING -->
            <Border x:Name="CardDeepHardware" Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="⚡ PRO RESPONSE &amp; SENSOR TUNING" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                    <TextBlock Text="Fine-tune trigger actuation, stick response, IMU motion control, and hardware protection directly on the controller." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- 1. Dual-Stage Trigger -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="DUAL-STAGE TRIGGER (SOFT PULL AIM / FULL PULL FIRE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Half-pull R2 (18%–80%) aims down sights (L2); pulling past the 85% tactile wall fires R2" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleDualStage" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="dualStageTriggers" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2. Rapid Trigger -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="RAPID TRIGGER INSTANT RESET (&lt;1.2MM)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Tracks peak trigger depth and resets the trigger the instant you release upward by 1.2mm at any depth" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleRapidTrigger" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="hairTriggerRelease" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 3. Outer-Ring Auto-Sprint -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="OUTER-RING AUTO-SPRINT (L3 AT 96% DEFLECTION)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Pushing Left Stick to the outer rim (≥96%) automatically engages L3 Sprint without clicking the stick" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleSprintShelf" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="sprintShelfL3" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 4. Touchpad Gyro Ratcheting -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="TOUCHPAD GYRO PAUSE (WRIST RECENTERING)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Resting a thumb on the touchpad temporarily pauses gyro aiming so you can recenter your hands like lifting a mouse" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleGyroRatchet" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="gyroRatcheting" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 5. Touchpad Tactile Scroll Detents -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="TOUCHPAD HAPTIC SCROLL DETENTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Pulses the palm voice coils for 1ms as your finger crosses virtual touchpad notches for a physical scroll-wheel feel" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleHapticDetent" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="hapticDetent" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 6. G-Shock Impact Stabilizer -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="G-SHOCK IMPACT STABILIZER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtLiveImpactG" Text="  [1.00 G]" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                                </StackPanel>
                                <TextBlock Text="Detects >1.85G physical controller jolts or heavy button presses and damps stick/gyro spikes for 25ms" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleGShockGuard" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="gShockGuard" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 7. Player LED Live Meter -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="PLAYER LED LIVE TELEMETRY METER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Drives the 5 white LEDs beneath the touchpad as a live hardware VU meter for trigger and haptic intensity" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="TogglePlayerLedBar" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="playerLedTelemetry" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 8. Microphone Preamp Boost -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="MICROPHONE HARDWARE PREAMP BOOST" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Enables the internal dual-mic array hardware preamp gain stage for clearer voice pickup" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleMicBeamforming" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="micBeamforming" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 9. Adaptive Recoil Compensation -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="ADAPTIVE VERTICAL RECOIL ASSIST" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Applies subtle downward pitch stabilization scaled to R2 trigger pressure while aiming down sights (L2 + R2)" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleRecoilAssist" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="recoilAssist" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                    <!-- 10. Trigger Motor Thermal Protection -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TRIGGER MOTOR THERMAL PROTECTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtLiveMotorTemp" Text="  [26.5°C]" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                </StackPanel>
                                <TextBlock Text="Monitors continuous trigger motor stall time and steps down holding force by 35% after 8s to prevent gear wear" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleThermalGuard" Content="OFF" Style="{StaticResource NovelToggleBtn}" Tag="thermalGuard" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleDeepFeature_Click"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- 5. STICK CURVES, VIRTUAL EMULATION & MACRO STUDIO -->
            <Border x:Name="CardProStudio" Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="STICK CURVES, VIRTUAL EMULATION &amp; MACRO STUDIO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" Margin="0,0,0,4"/>
                    <TextBlock Text="Switch between Xbox 360 and native DualShock 4 emulation, shape Bezier stick curves, calibrate trigger travel, and configure macros." FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                    <!-- 1. Virtual Controller Emulation Mode (Xbox 360 vs Native DS4) -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VIRTUAL CONTROLLER EMULATION MODE (ViGEmBus)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Choose Xbox 360 for universal XInput compatibility or Native DualShock 4 for PlayStation glyphs &amp; touchpad" FontSize="9.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbVirtualPadMode" Width="175" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CmbVirtualPadMode_SelectionChanged">
                                    <ComboBoxItem Content="Xbox 360 (XInput)"/>
                                    <ComboBoxItem Content="DualShock 4 (Native PS)"/>
                                    <ComboBoxItem Content="Disabled (Raw HID Only)"/>
                                </ComboBox>
                            </Grid>

                            <!-- HidHide Double-Input Cloak & Conflict Guard -->
                            <Grid>
                                <TextBlock x:Name="TxtConflictStatus" Text="Conflict Guard: No Steam Input / DS4Windows double-input hooks detected" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                                <Button x:Name="BtnScanConflicts" Content="Scan &amp; Cloak Check" Padding="10,4" FontSize="10" FontWeight="Bold" Background="#162238" Foreground="{StaticResource AccentSignature}" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" HorizontalAlignment="Right" Cursor="Hand" Click="BtnScanConflicts_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. 4-Point Bezier Stick Response Curves & Live Graph -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="4-PRESET BEZIER ANALOG STICK RESPONSE CURVES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Left Stick (Movement):" FontSize="10.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbLeftStickCurve" Width="165" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CmbStickCurve_SelectionChanged">
                                            <ComboBoxItem Content="Linear (1:1 Raw)"/>
                                            <ComboBoxItem Content="Precision Sniper"/>
                                            <ComboBoxItem Content="Aggressive Snap"/>
                                            <ComboBoxItem Content="Dynamic S-Curve"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Right Stick (Camera/Aim):" FontSize="10.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbRightStickCurve" Width="165" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CmbStickCurve_SelectionChanged">
                                            <ComboBoxItem Content="Linear (1:1 Raw)"/>
                                            <ComboBoxItem Content="Precision Sniper"/>
                                            <ComboBoxItem Content="Aggressive Snap"/>
                                            <ComboBoxItem Content="Dynamic S-Curve"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Deadzone Gate Shape:" FontSize="10.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbDeadzoneShape" Width="165" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CmbStickCurve_SelectionChanged">
                                            <ComboBoxItem Content="Circular Radial Gate"/>
                                            <ComboBoxItem Content="Axial Cross Gate"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#090D16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <Canvas x:Name="CanvasStickCurvePreview" Width="110" Height="90" ClipToBounds="True"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,8,0,2">
                                <TextBlock Text="ANTI-DEADZONE BOOST (COUNTERACTS BUILT-IN GAME DEADZONES)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtAntiDeadzoneVal" Text="0%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderAntiDeadzone" Minimum="0" Maximum="25" Value="0" ValueChanged="SliderAntiDeadzone_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Flick-Stick 360 Camera & DualSense Edge Shift Layer -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                    <TextBlock Text="FLICK-STICK 360 CAMERA ENGINE (RIGHT STICK + GYRO)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Snapping Right Stick rotates your camera to that exact 360 angle; rotating the rim smoothly turns you" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleFlickStick" Content="OFF" Style="{StaticResource NovelToggleBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleFlickStick_Click"/>
                            </Grid>
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                    <TextBlock Text="DUALSENSE EDGE BACK-PADDLE / FN SNIPER SHIFT LAYER (50%)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Holding Fn Left or Left Back Paddle temporarily halves stick and gyro sensitivity for pinpoint sniping" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleEdgeShift" Content="OFF" Style="{StaticResource NovelToggleBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleEdgeShift_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Trigger Actuation Distance & Hardware Rapid-Fire Macro -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="TRIGGER FULL-PULL ACTUATION DEPTH (L2 &amp; R2 MAX TRAVEL)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="TxtTriggerMaxDepthVal" Text="100% Travel" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderTriggerMaxDepth" Minimum="25" Maximum="100" Value="100" Margin="0,0,0,10" ValueChanged="SliderTriggerMaxDepth_ValueChanged"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                    <TextBlock Text="HARDWARE TURBO RAPID-FIRE MACRO (15 Hz R2 PULSE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Automatically pulses R2 at 15 shots/sec while held down for semi-auto weapons" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="ToggleRapidFireMacro" Content="OFF" Style="{StaticResource NovelToggleBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleRapidFireMacro_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
