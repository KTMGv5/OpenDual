<UserControl x:Class="OpenDualHub.CrossMediaBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenDualHub"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#B388FF"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2979FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF334B"/>
        <SolidColorBrush x:Key="AccentMagenta" Color="#FF007F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AACC4"/>
        <SolidColorBrush x:Key="BgCard" Color="#CC0E1422"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#E6162033"/>
        <SolidColorBrush x:Key="SlotBg" Color="#B0080C14"/>
        <SolidColorBrush x:Key="BorderColor" Color="#352979FF"/>

        <!-- XMB Button Style -->
        <Style x:Key="XmbActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="#1C2740"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Status Header -->
            <RowDefinition Height="50"/>
            <!-- Horizontal XMB Category Axis -->
            <RowDefinition Height="96"/>
            <!-- XMB Main Split: Vertical Items (Left) + Interactive Inspector (Right) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Navigation Action Bar -->
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP STATUS HEADER -->
        <Border Grid.Row="0" Background="#A0080B13" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: User Profile Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#2600F5D4" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1.2" Margin="0,0,8,0">
                        <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="USER 1 (TYLER)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  OPENDUAL CROSS BAR HUB" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: High-Priority 1000Hz HID Bus Engine Pill -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#1800E676" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="12" Padding="12,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtTopBusInfo" Text="1000Hz DIRECT HID KERNEL BUS • 0.8ms LATENCY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                    </StackPanel>
                </Border>

                <!-- Right: Date, Real-Time Clock & Battery -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtXmbClock" Text="Sat 31/10  1:15 AM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtXmbBatteryIcon" Text="⚡" FontSize="11" Foreground="{StaticResource AccentGreen}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtXmbBattery" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. HORIZONTAL XMB CATEGORY AXIS -->
        <Border Grid.Row="1" Background="#60080B13" BorderBrush="#202979FF" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Luminous Horizontal Guide Axis -->
                <Border Height="1" VerticalAlignment="Center" Margin="0,0,0,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.0"/>
                            <GradientStop Color="#4000F5D4" Offset="0.15"/>
                            <GradientStop Color="#802979FF" Offset="0.5"/>
                            <GradientStop Color="#4000F5D4" Offset="0.85"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Horizontal Categories Carousel -->
                <ScrollViewer x:Name="CategoryScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" HorizontalAlignment="Center">
                    <StackPanel x:Name="PanelCategories" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Dynamically populated or bound categories -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. XMB MAIN CONTENT (2-COLUMN SPLIT: VERTICAL ITEMS + INSPECTOR) -->
        <Grid Grid.Row="2" Margin="18,12,18,8">
            <Grid.ColumnDefinitions>
                <!-- Left: Vertical Item Stack (XMB Dropdown) -->
                <ColumnDefinition Width="340"/>
                <!-- Column Divider Spacing -->
                <ColumnDefinition Width="14"/>
                <!-- Right: Real-Time Interactive Inspector -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: VERTICAL XMB ITEMS -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="14" Padding="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Title Header -->
                    <Grid Grid.Row="0" Margin="4,2,4,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCategoryIcon" Text="🎮" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtCategoryHeader" Text="CONTROLLER SETTINGS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                        </StackPanel>
                        <TextBlock Text="Select item to inspect" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Vertical Scrollable Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:SmoothScrollHelper.SmoothScroll="True">
                        <StackPanel x:Name="PanelItems">
                            <!-- Dynamically populated XMB item tiles with glowing selection capsules -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: REAL-TIME INTERACTIVE INSPECTOR -->
            <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="14" Padding="14" ClipToBounds="True">
                <Grid>
                    <!-- Active Sub-Panel Container -->
                    <ContentControl x:Name="InspectorContentHost"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. BOTTOM SYSTEM STATUS FOOTER -->
        <Border Grid.Row="3" Background="#C0080B13" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Hardware Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFooterStatus" Text="Controller 1000Hz Ready" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="  •  " FontSize="11" Foreground="{StaticResource BorderColor}"/>
                    <TextBlock x:Name="TxtFooterConnection" Text="Direct Win32 Overlapped" FontSize="11" Foreground="{StaticResource AccentGreen}"/>
                </StackPanel>

                <!-- Center: Active Profile & Kernel Engine Telemetry -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                    <Border Background="#1A00E5FF" BorderBrush="#4000E5FF" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PROFILE: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            <TextBlock x:Name="TxtFooterProfile" Text="Standard Balanced" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A00E676" BorderBrush="#4000E676" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KERNEL: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                            <TextBlock Text="Direct Overlapped I/O" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A7C4DFF" BorderBrush="#407C4DFF" BorderThickness="1" CornerRadius="6" Padding="7,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HARDWARE SUITE: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                            <TextBlock Text="Sentinel • Hall Stabilizer • Radar" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: OpenDual Version -->
                <TextBlock Grid.Column="2" Text="v1.6.6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
