<UserControl x:Class="OpenDualHub.ControllerInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenDualHub"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="680">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentSignature" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2979FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF334B"/>
        <SolidColorBrush x:Key="AccentMagenta" Color="#FF007F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AACC4"/>
        <SolidColorBrush x:Key="BgCard" Color="#CC0E1422"/>
        <SolidColorBrush x:Key="SlotBg" Color="#B0080C14"/>
        <SolidColorBrush x:Key="PillBg" Color="#1F283B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#352979FF"/>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C2740"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="ControllerScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:SmoothScrollHelper.SmoothScroll="True">
        <StackPanel Margin="6">

            <!-- 1. HERO INFORMATION & TELEMETRY CARD -->
            <Border x:Name="CardOverview" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModelTitle" Text="DualSense Wireless Controller" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource AccentSignature}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtProfileBadge" Text="Standard Balanced" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock x:Name="TxtConnectionInfo" Text="Active USB Connection • Direct Win32 Overlapped High-Priority Driver" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Telemetry Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="POLLING RATE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                                <TextBlock x:Name="TxtHzVal" Text="1000 Hz" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="INPUT LATENCY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                <TextBlock x:Name="TxtLatencyVal" Text="0.8 ms" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. LIVE INPUT TEST & ANALOG SENSORS -->
            <Border x:Name="CardLiveInput" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕹️" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="LIVE HARDWARE INPUT VISUALIZER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                        </StackPanel>
                        <TextBlock Text="Real-time 1000Hz HID Bus Polling" FontSize="10" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Interactive Full Controller Hardware Schematic -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="185"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="4,0,4,4">
                                <TextBlock Text="INTERACTIVE CONTROLLER HARDWARE SCHEMATIC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                                <TextBlock x:Name="TxtSchematicTouchInfo" Text="Touchpad: Idle • Bumpers &amp; Face Buttons Live" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Viewbox Grid.Row="1" Stretch="Uniform" Width="460" Height="180">
                                <Canvas Width="460" Height="180">
                                    <!-- L2 / R2 Adaptive Trigger Silhouettes -->
                                    <Path x:Name="SvgL2" Data="M 102,22 C 102,10 144,10 144,22 L 148,36 L 98,36 Z" Fill="#162032" Stroke="#352979FF" StrokeThickness="1.5"/>
                                    <TextBlock Text="L2" Canvas.Left="116" Canvas.Top="14" FontSize="9" FontWeight="Bold" Foreground="#9AACC4"/>
                                    <Path x:Name="SvgR2" Data="M 316,22 C 316,10 358,10 358,22 L 362,36 L 312,36 Z" Fill="#162032" Stroke="#352979FF" StrokeThickness="1.5"/>
                                    <TextBlock Text="R2" Canvas.Left="330" Canvas.Top="14" FontSize="9" FontWeight="Bold" Foreground="#9AACC4"/>

                                    <!-- L1 / R1 Shoulder Bumpers -->
                                    <Path x:Name="SvgL1" Data="M 92,38 C 96,28 152,28 156,38 L 158,48 L 90,48 Z" Fill="#1B263B" Stroke="#452979FF" StrokeThickness="1.5"/>
                                    <TextBlock Text="L1" Canvas.Left="118" Canvas.Top="33" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Path x:Name="SvgR1" Data="M 304,38 C 308,28 364,28 368,38 L 370,48 L 302,48 Z" Fill="#1B263B" Stroke="#452979FF" StrokeThickness="1.5"/>
                                    <TextBlock Text="R1" Canvas.Left="330" Canvas.Top="33" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>

                                    <!-- Outer Controller Two-Tone Ergonomic Shell -->
                                    <Path Data="M 95,44 L 162,40 L 298,40 L 365,44 C 392,50 408,85 398,136 C 392,165 372,174 352,164 C 334,154 322,126 302,122 L 158,122 C 138,126 126,154 108,164 C 88,174 68,165 62,136 C 52,85 68,50 95,44 Z"
                                          Fill="#182235" Stroke="#552979FF" StrokeThickness="2"/>

                                    <!-- Inner Dark Lower Bridge Core -->
                                    <Path Data="M 140,88 L 320,88 L 340,146 C 328,132 316,122 300,122 L 160,122 C 144,122 132,132 120,146 Z"
                                          Fill="#0E1420" Stroke="#302979FF" StrokeThickness="1"/>

                                    <!-- Glowing Lightbar Accent Wings -->
                                    <Path x:Name="SvgLightbarLeft" Data="M 164,43 L 175,82" Stroke="#00F5D4" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path x:Name="SvgLightbarRight" Data="M 296,43 L 285,82" Stroke="#00F5D4" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                    <!-- Capacitive Touchpad Trapezoid & Live Touch Dots -->
                                    <Path x:Name="SvgTouchpad" Data="M 168,42 L 292,42 L 281,82 L 179,82 Z" Fill="#111827" Stroke="#4500F5D4" StrokeThickness="1.2"/>
                                    <Ellipse x:Name="SvgTouchDot1" Width="8" Height="8" Fill="#00F5D4" Stroke="White" StrokeThickness="1.2" Canvas.Left="226" Canvas.Top="58" Visibility="Collapsed"/>
                                    <Ellipse x:Name="SvgTouchDot2" Width="8" Height="8" Fill="#FF007F" Stroke="White" StrokeThickness="1.2" Canvas.Left="240" Canvas.Top="58" Visibility="Collapsed"/>

                                    <!-- Create / Options Buttons -->
                                    <Rectangle x:Name="SvgShareBtn" Canvas.Left="150" Canvas.Top="48" Width="7" Height="13" RadiusX="3" RadiusY="3" Fill="#25324B" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                                    <Rectangle x:Name="SvgOptionsBtn" Canvas.Left="303" Canvas.Top="48" Width="7" Height="13" RadiusX="3" RadiusY="3" Fill="#25324B" Stroke="#50FFFFFF" StrokeThickness="0.8"/>

                                    <!-- D-Pad (Left Wing) -->
                                    <Rectangle x:Name="SvgDpadUp" Canvas.Left="114" Canvas.Top="58" Width="12" Height="13" RadiusX="2" RadiusY="2" Fill="#222E46" Stroke="#40FFFFFF" StrokeThickness="0.8"/>
                                    <Rectangle x:Name="SvgDpadDown" Canvas.Left="114" Canvas.Top="83" Width="12" Height="13" RadiusX="2" RadiusY="2" Fill="#222E46" Stroke="#40FFFFFF" StrokeThickness="0.8"/>
                                    <Rectangle x:Name="SvgDpadLeft" Canvas.Left="101" Canvas.Top="71" Width="13" Height="12" RadiusX="2" RadiusY="2" Fill="#222E46" Stroke="#40FFFFFF" StrokeThickness="0.8"/>
                                    <Rectangle x:Name="SvgDpadRight" Canvas.Left="126" Canvas.Top="71" Width="13" Height="12" RadiusX="2" RadiusY="2" Fill="#222E46" Stroke="#40FFFFFF" StrokeThickness="0.8"/>

                                    <!-- Action Buttons (Right Wing) -->
                                    <Ellipse x:Name="SvgBtnTriangle" Canvas.Left="332" Canvas.Top="55" Width="15" Height="15" Fill="#222E46" Stroke="#00E676" StrokeThickness="1.2"/>
                                    <Ellipse x:Name="SvgBtnCross" Canvas.Left="332" Canvas.Top="85" Width="15" Height="15" Fill="#222E46" Stroke="#2979FF" StrokeThickness="1.2"/>
                                    <Ellipse x:Name="SvgBtnSquare" Canvas.Left="317" Canvas.Top="70" Width="15" Height="15" Fill="#222E46" Stroke="#FF007F" StrokeThickness="1.2"/>
                                    <Ellipse x:Name="SvgBtnCircle" Canvas.Left="347" Canvas.Top="70" Width="15" Height="15" Fill="#222E46" Stroke="#FF334B" StrokeThickness="1.2"/>

                                    <!-- Symmetrical Thumbstick Rings & Moving Stick Caps (L3 / R3) -->
                                    <Ellipse Canvas.Left="158" Canvas.Top="86" Width="38" Height="38" Fill="#0A0E17" Stroke="#402979FF" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="SvgStickCapL" Canvas.Left="165" Canvas.Top="93" Width="24" Height="24" Fill="#1E293B" Stroke="#00F5D4" StrokeThickness="2"/>

                                    <Ellipse Canvas.Left="264" Canvas.Top="86" Width="38" Height="38" Fill="#0A0E17" Stroke="#402979FF" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="SvgStickCapR" Canvas.Left="271" Canvas.Top="93" Width="24" Height="24" Fill="#1E293B" Stroke="#FF007F" StrokeThickness="2"/>

                                    <!-- Center Home & Mic Mute Buttons -->
                                    <Ellipse x:Name="SvgHomeBtn" Canvas.Left="223" Canvas.Top="96" Width="14" Height="14" Fill="#222E46" Stroke="#00F5D4" StrokeThickness="1.2"/>
                                    <Rectangle x:Name="SvgMicBtn" Canvas.Left="224" Canvas.Top="113" Width="12" Height="5" RadiusX="2" RadiusY="2" Fill="#222E46" Stroke="#FFA000" StrokeThickness="0.8"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Analog Thumbsticks (L3 / R3) & Triggers (L2 / R2) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Stick & L2 Trigger -->
                        <Border Grid.Column="0" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="LEFT ANALOG &amp; L2 TRIGGER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Stick Crosshair Radar -->
                                <Border Width="110" Height="110" Background="#0C101A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="55">
                                    <Canvas x:Name="CanvasStickL" Width="110" Height="110" ClipToBounds="True"/>
                                </Border>
                                <TextBlock x:Name="TxtCoordsL" Text="X: +0.00  Y: +0.00" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Center" Margin="0,6,0,8"/>

                                <!-- L2 Trigger Gauge -->
                                <Grid Width="110">
                                    <TextBlock Text="L2" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtTriggerLVal" Text="0%" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentSignature}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarTriggerL" Width="110" Height="6" Minimum="0" Maximum="100" Value="0" Background="#141B2B" Foreground="{StaticResource AccentSignature}" BorderThickness="0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Stick & R2 Trigger -->
                        <Border Grid.Column="2" Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="RIGHT ANALOG &amp; R2 TRIGGER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Stick Crosshair Radar -->
                                <Border Width="110" Height="110" Background="#0C101A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="55">
                                    <Canvas x:Name="CanvasStickR" Width="110" Height="110" ClipToBounds="True"/>
                                </Border>
                                <TextBlock x:Name="TxtCoordsR" Text="X: +0.00  Y: +0.00" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentMagenta}" HorizontalAlignment="Center" Margin="0,6,0,8"/>

                                <!-- R2 Trigger Gauge -->
                                <Grid Width="110">
                                    <TextBlock Text="R2" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtTriggerRVal" Text="0%" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentMagenta}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarTriggerR" Width="110" Height="6" Minimum="0" Maximum="100" Value="0" Background="#141B2B" Foreground="{StaticResource AccentMagenta}" BorderThickness="0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Buttons & D-Pad Status Row -->
                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Directional D-Pad -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="DIRECTIONAL D-PAD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Grid Width="90" Height="90">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BtnDpadUp" Grid.Row="0" Grid.Column="1" Background="{StaticResource PillBg}" CornerRadius="4" Margin="2">
                                        <TextBlock Text="▲" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BtnDpadLeft" Grid.Row="1" Grid.Column="0" Background="{StaticResource PillBg}" CornerRadius="4" Margin="2">
                                        <TextBlock Text="◀" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BtnDpadRight" Grid.Row="1" Grid.Column="2" Background="{StaticResource PillBg}" CornerRadius="4" Margin="2">
                                        <TextBlock Text="▶" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BtnDpadDown" Grid.Row="2" Grid.Column="1" Background="{StaticResource PillBg}" CornerRadius="4" Margin="2">
                                        <TextBlock Text="▼" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Column="1" Background="{StaticResource BorderColor}"/>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="ACTION BUTTONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Grid Width="90" Height="90">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Triangle △ -->
                                    <Border x:Name="BtnTriangle" Grid.Row="0" Grid.Column="1" Background="{StaticResource PillBg}" CornerRadius="14" Margin="2">
                                        <TextBlock Text="△" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Square □ -->
                                    <Border x:Name="BtnSquare" Grid.Row="1" Grid.Column="0" Background="{StaticResource PillBg}" CornerRadius="14" Margin="2">
                                        <TextBlock Text="□" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentMagenta}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Circle ◯ -->
                                    <Border x:Name="BtnCircle" Grid.Row="1" Grid.Column="2" Background="{StaticResource PillBg}" CornerRadius="14" Margin="2">
                                        <TextBlock Text="◯" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentRed}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Cross ✕ -->
                                    <Border x:Name="BtnCross" Grid.Row="2" Grid.Column="1" Background="{StaticResource PillBg}" CornerRadius="14" Margin="2">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. 1000 HZ USB OVERCLOCK ASSISTANT CARD -->
            <Border x:Name="CardOverclock" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="1000 HZ USB OVERCLOCK ASSISTANT" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSignature}"/>
                        </StackPanel>
                        <Border Background="#2000E676" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                            <TextBlock Text="1.0 MS ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="SweetLow HIDUSBF kernel filter driver boosts controller USB polling from standard 250Hz to authentic 1000Hz (1.0ms input response)." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Background="{StaticResource SlotBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SWEETLOW FILTER STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Filter installed on USB port • bInterval: 1 (1000Hz target)" FontSize="10" Foreground="{StaticResource AccentGreen}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnLaunchOverclock" Content="Launch Overclock Wizard" Style="{StaticResource ModernBtn}" Background="{StaticResource AccentBlue}" Foreground="#FFFFFF" HorizontalAlignment="Right" Padding="12,6" Click="BtnLaunchOverclock_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
